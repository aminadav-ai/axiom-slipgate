// ============================================================================
// AXIOM SLIPGATE (1996-Style Dark-Industrial 3D FPS — "Slipgate Complex")
// 100% Clean-Room Original IP • Written 100% in Axiom (Telos + Flux + Strata)
// Compiles directly to standalone W3C WebAssembly (.wasm) with ZERO rustc!
// ============================================================================

// --- Layer 1: Axiom.Telos Mathematically Verified Pure Kernels (Z3 SMT) ---

fn clamp_byte(v: i64) -> i64
  ens result >= 0 && result <= 255
{
  if v < 0 {
    0
  } else {
    if v > 255 { 255 } else { v }
  }
}

fn clamp_stat(v: i64, max_v: i64) -> i64
  req max_v >= 0
  ens result >= 0 && result <= max_v
{
  if v < 0 {
    0
  } else {
    if v > max_v { max_v } else { v }
  }
}

fn abs_val(v: i64) -> i64
  ens result >= 0
{
  if v < 0 { -v } else { v }
}

fn map_idx(mx: i64, my: i64) -> i64
  req mx >= 0 && mx < 24 && my >= 0 && my < 24
  ens result >= 0 && result < 576
{
  my * 24 + mx
}

fn tex_addr(tid: i64, tx: i64, ty: i64) -> i64
  req tid >= 0 && tid < 8
{
  4096 + tid * 4096 + ((ty & 63) * 64) + (tx & 63)
}

fn enemy_addr(eid: i64) -> i64
  req eid >= 0 && eid < 8
  ens result >= 1400 && result < 1528
{
  1400 + eid * 12
}

fn item_addr(iid: i64) -> i64
  req iid >= 0 && iid < 8
  ens result >= 1600 && result < 1696
{
  1600 + iid * 8
}

fn snap_addr(slot: i64) -> i64
  req slot >= 0 && slot < 120
  ens result >= 40000 && result < 60000
{
  40000 + slot * 160
}

fn compute_fps_score(kills: i64, hp_left: i64, slipgate_bonus: i64) -> i64
  req kills >= 0 && kills <= 8 && hp_left >= 0 && hp_left <= 100 && slipgate_bonus >= 0 && slipgate_bonus <= 1000
  ens result >= 0 && result <= 4000
{
  kills * 250 + hp_left * 5 + slipgate_bonus
}

fn pack_rgba(r: i64, g: i64, b: i64) -> i64 {
  let cr = clamp_byte(r);
  let cg = clamp_byte(g);
  let cb = clamp_byte(b);
  (255 << 24) | (cb << 16) | (cg << 8) | cr
}

// --- Layer 3: Axiom.Strata Linear Memory Map ---
//   0: tick            1: px (1024/tile)  2: py (1024/tile)  3: pang (0..1023)
//   4: health          5: armor           6: ammo            7: kills
//   8: score           9: muzzle_timer   10: recoil_timer   11: hurt_flash
//  12: pickup_flash   13: bob_phase      14: game_state     15: sfx_mask
//  16: snap_head      17: snap_count     18: rng_state      19: slime_tick
//  128..703:   24x24 Wall Map (0=open, 1=TechIron, 2=Brownstone, 3=CopperDoor, 4=TorchWall, 5=ExitSlipgate)
//  704..1279:  24x24 Floor Sector Map (0=IronGrate, 1=RadioactiveSlime, 2=StormSkyCourtyard)
// 1400..1495:  8 Enemies * 12 words (x, y, kind, hp, state, cooldown, hit_flash, anim)
// 1600..1663:  8 Pickups * 8 words (x, y, kind, active)
// 2048..3071:  1024-entry Fixed-Point Sin Table (-1024..1024)
// 3200..3919:  720-column Z-Buffer (`perp_dist`)
// 3920..3950:  Enemy depth-sort scratch
// 4096..36863: 8 Procedural 64x64 24-bit Textures
// 40000..59199: 120 Time-Travel Combat Snapshots * 160 words
// 65536..389535: 720x450 Widescreen RGBA Framebuffer (byte offset = 262144)

fn next_rand() -[Mem]-> i64 {
  let s = mem_load(18);
  let nxt = (s * 1103515245 + 12345) & 0x7FFFFFFF;
  let safe = if nxt == 0 { 7654321 } else { nxt };
  mem_store(18, safe);
  safe
}

fn fast_sin(ang: i64) -[Mem]-> i64 {
  mem_load(2048 + (ang & 1023))
}

fn fast_cos(ang: i64) -[Mem]-> i64 {
  mem_load(2048 + ((ang + 256) & 1023))
}

// Bhaskara I's high-accuracy rational sine table (`0..1023` -> `-1024..1024`)
fn init_trig_tables() -[Mem]-> unit {
  let mut i = 0;
  while i < 512 max 512 {
    let p = i * (512 - i);
    let denom = 1310720 - 4 * p;
    let s = if denom > 0 { (16 * p * 1024) / denom } else { 0 };
    mem_store(2048 + i, s);
    mem_store(2048 + 512 + i, -s);
    i = i + 1;
  }
}

// Bake 8 rich 1996-era Dark-Industrial & Gothic 64x64 textures in pure math!
fn bake_procedural_textures() -[Mem]-> unit {
  let mut ty = 0;
  while ty >= 0 && ty < 64 max 64 {
    let mut tx = 0;
    while tx >= 0 && tx < 64 max 64 {
      let grit = (((tx * 73 ^ ty * 149) + tx * ty) >> 2) & 15;

      // Tex 0 (Wall 1): Riveted Rusted Tech-Base Iron Panels
      let seam = tx == 0 || ty == 0 || ty == 32 || tx == 32;
      let bevel_hi = tx == 1 || ty == 1 || ty == 33 || tx == 33;
      let rivet = ((tx & 31) == 4 || (tx & 31) == 27) && ((ty & 31) == 4 || (ty & 31) == 27);
      let rust = ((tx * 13 + ty * 29) >> 4) & 7;
      let t0_r = if seam { 26 } else { if bevel_hi { 112 } else { if rivet { 138 } else { 78 + grit - rust } } };
      let t0_g = if seam { 24 } else { if bevel_hi { 98 } else { if rivet { 124 } else { 68 + (grit * 2) / 3 - rust } } };
      let t0_b = if seam { 22 } else { if bevel_hi { 84 } else { if rivet { 108 } else { 58 + grit / 2 - rust } } };
      mem_store(tex_addr(0, tx, ty), pack_rgba(t0_r, t0_g, t0_b));

      // Tex 1 (Wall 2): Weathered Gothic Brownstone Masonry with Deep Mortar & Moss
      let brick_row = ty >> 4;
      let bx = (tx + (brick_row & 1) * 16) & 31;
      let by = ty & 15;
      let mortar = bx == 0 || by == 0 || by == 15;
      let moss = if ty > 44 && ((tx * 19 ^ ty * 41) & 7) == 0 { 1 } else { 0 };
      let stone_var = ((brick_row * 37 + ((tx + (brick_row & 1) * 16) >> 5) * 53) & 15) - 7;
      let t1_r = if mortar { 32 } else { if moss == 1 { 48 } else { 96 + stone_var + grit / 2 } };
      let t1_g = if mortar { 28 } else { if moss == 1 { 82 } else { 76 + stone_var + grit / 2 } };
      let t1_b = if mortar { 24 } else { if moss == 1 { 44 } else { 58 + stone_var / 2 + grit / 3 } };
      mem_store(tex_addr(1, tx, ty), pack_rgba(t1_r, t1_g, t1_b));

      // Tex 2 (Wall 3): Stained Copper Trim & Hazard Ribs
      let rib = (ty & 7) < 2;
      let stripe = if ty >= 24 && ty < 40 { ((tx + ty) >> 3) & 1 } else { 2 };
      let t2_r = if stripe == 1 { 176 + grit } else { if stripe == 0 { 38 } else { if rib { 52 } else { 116 + grit } } };
      let t2_g = if stripe == 1 { 132 + grit } else { if stripe == 0 { 34 } else { if rib { 42 } else { 78 + grit / 2 } } };
      let t2_b = if stripe == 1 { 42 } else { if stripe == 0 { 30 } else { if rib { 36 } else { 52 + grit / 3 } } };
      mem_store(tex_addr(2, tx, ty), pack_rgba(t2_r, t2_g, t2_b));

      // Tex 3 (Wall 4): Gothic Torch Alcove with Glowing Amber Flame!
      let dx_c = tx - 32;
      let dy_c = ty - 28;
      let in_alcove = abs_val(dx_c) < 12 && ty >= 12 && ty <= 50;
      let flame_d = dx_c * dx_c * 2 + dy_c * dy_c;
      let is_flame = flame_d < 110 && ty <= 34;
      let is_sconce = abs_val(dx_c) <= 4 && ty > 34 && ty <= 48;
      let t3_r = if is_flame { 255 } else { if is_sconce { 58 } else { if in_alcove { 46 + grit } else { t1_r } } };
      let t3_g = if is_flame { 215 - flame_d } else { if is_sconce { 46 } else { if in_alcove { 36 + grit / 2 } else { t1_g } } };
      let t3_b = if is_flame { 68 } else { if is_sconce { 38 } else { if in_alcove { 28 } else { t1_b } } };
      mem_store(tex_addr(3, tx, ty), pack_rgba(t3_r, t3_g, t3_b));

      // Tex 4 (Wall 5): Swirling Runic Exit Slipgate Portal!
      let pdx = tx - 32;
      let pdy = ty - 32;
      let pr2 = pdx * pdx + pdy * pdy;
      let frame_arch = abs_val(pdx) >= 22 || ty < 8;
      let rune_ring = pr2 >= 280 && pr2 <= 460;
      let swirl = ((pdx * 7 + pdy * 11 + pr2 / 6) >> 2) & 31;
      let t4_r = if frame_arch { 128 + grit } else { if rune_ring { 250 } else { 110 + swirl * 4 } };
      let t4_g = if frame_arch { 96 + grit / 2 } else { if rune_ring { 196 } else { 40 + swirl * 3 } };
      let t4_b = if frame_arch { 64 } else { if rune_ring { 68 } else { 195 + swirl * 2 } };
      mem_store(tex_addr(4, tx, ty), pack_rgba(t4_r, t4_g, t4_b));

      // Tex 5 (Floor 0): Industrial Diamond Metal Grate & Dark Flagstone
      let f_seam = (tx & 15) == 0 || (ty & 15) == 0;
      let mesh = ((tx + ty) & 3) == 0 && ((tx - ty) & 3) == 0;
      let f_r = if f_seam { 30 } else { if mesh { 74 + grit / 2 } else { 54 + grit / 2 } };
      let f_g = if f_seam { 28 } else { if mesh { 68 + grit / 2 } else { 50 + grit / 2 } };
      let f_b = if f_seam { 26 } else { if mesh { 62 + grit / 2 } else { 46 + grit / 2 } };
      mem_store(tex_addr(5, tx, ty), pack_rgba(f_r, f_g, f_b));

      // Tex 6 (Floor 1): Glowing Radioactive Green Acid Slime!
      let wave = ((tx * 9 + ty * 7) ^ (tx * 3 - ty * 5)) & 31;
      let s_r = 38 + wave * 2;
      let s_g = 135 + wave * 3;
      let s_b = 32 + wave;
      mem_store(tex_addr(6, tx, ty), pack_rgba(s_r, s_g, s_b));

      // Tex 7 (Ceiling): Vaulted Ribbed Iron & Dark Indigo Tempest Clouds
      let beam = (tx & 31) < 3 || (ty & 31) < 3;
      let c_r = if beam { 38 } else { 54 + grit / 2 };
      let c_g = if beam { 34 } else { 44 + grit / 2 };
      let c_b = if beam { 40 } else { 66 + grit };
      mem_store(tex_addr(7, tx, ty), pack_rgba(c_r, c_g, c_b));

      tx = tx + 1;
    }
    ty = ty + 1;
  }
}

fn set_wall_box(x0: i64, y0: i64, x1: i64, y1: i64, wtype: i64) -[Mem]-> unit {
  let mut y = y0;
  while y <= y1 max 24 {
    if y >= 0 && y < 24 {
      let mut x = x0;
      while x <= x1 max 24 {
        if x >= 0 && x < 24 {
          mem_store(128 + map_idx(x, y), wtype);
        } else { () };
        x = x + 1;
      }
    } else { () };
    y = y + 1;
  }
}

fn set_floor_box(x0: i64, y0: i64, x1: i64, y1: i64, ftype: i64) -[Mem]-> unit {
  let mut y = y0;
  while y <= y1 max 24 {
    if y >= 0 && y < 24 {
      let mut x = x0;
      while x <= x1 max 24 {
        if x >= 0 && x < 24 {
          mem_store(704 + map_idx(x, y), ftype);
        } else { () };
        x = x + 1;
      }
    } else { () };
    y = y + 1;
  }
}

fn spawn_enemy(eid: i64, tx: i64, ty: i64, kind: i64, hp: i64) -[Mem]-> unit {
  if eid >= 0 && eid < 8 {
    let base = enemy_addr(eid);
    mem_store(base, tx * 1024 + 512);
    mem_store(base + 1, ty * 1024 + 512);
    mem_store(base + 2, kind);
    mem_store(base + 3, hp);
    mem_store(base + 4, 0);
    mem_store(base + 5, 25 + eid * 7);
    mem_store(base + 6, 0);
    mem_store(base + 7, eid * 5);
  } else { () }
}

fn spawn_item(iid: i64, tx: i64, ty: i64, kind: i64) -[Mem]-> unit {
  if iid >= 0 && iid < 8 {
    let base = item_addr(iid);
    mem_store(base, tx * 1024 + 512);
    mem_store(base + 1, ty * 1024 + 512);
    mem_store(base + 2, kind);
    mem_store(base + 3, 1);
  } else { () }
}

// Build the complete E1M1-inspired "Slipgate Complex" architectural level (`24x24`)!
fn build_slipgate_level() -[Mem]-> unit {
  // Fill solid gothic stone & clear floor sectors
  set_wall_box(0, 0, 23, 23, 2);
  set_floor_box(0, 0, 23, 23, 0);

  // Room 1: Tech-Base Entry Bunker (`x: 2..6, y: 2..6`)
  set_wall_box(1, 1, 7, 7, 1);
  set_wall_box(2, 2, 6, 6, 0);
  mem_store(128 + map_idx(1, 4), 4); // Torch!
  mem_store(128 + map_idx(4, 1), 3); // Copper bulkhead trim

  // East Tech Corridor (`x: 7..10, y: 3..5`)
  set_wall_box(7, 3, 10, 5, 0);
  mem_store(128 + map_idx(8, 2), 4);
  mem_store(128 + map_idx(8, 6), 4);

  // Room 2: Radioactive Slime Bridge Hall (`x: 11..17, y: 2..8`)
  set_wall_box(11, 2, 17, 8, 0);
  // Glowing green acid canals north & south of central iron bridge (`y == 4..5`)!
  set_floor_box(12, 2, 16, 3, 1);
  set_floor_box(12, 6, 16, 8, 1);
  mem_store(128 + map_idx(14, 1), 4);
  mem_store(128 + map_idx(18, 4), 4);

  // South Connector Passage (`x: 13..15, y: 9..11`)
  set_wall_box(13, 9, 15, 11, 0);
  mem_store(128 + map_idx(12, 10), 3);
  mem_store(128 + map_idx(16, 10), 3);

  // Room 3: Open-Sky Gothic Pillared Courtyard (`x: 8..19, y: 12..18`)
  set_wall_box(8, 12, 19, 18, 0);
  set_floor_box(8, 12, 19, 18, 2); // Open tempest storm sky!
  // 4 Heavy Copper/Stone Tactical Cover Pillars + Torch Braziers
  mem_store(128 + map_idx(11, 14), 3);
  mem_store(128 + map_idx(16, 14), 3);
  mem_store(128 + map_idx(11, 16), 3);
  mem_store(128 + map_idx(16, 16), 3);
  mem_store(128 + map_idx(7, 15), 4);
  mem_store(128 + map_idx(20, 15), 4);

  // West Fortress Stairway Hall (`x: 3..7, y: 14..16`) -> Sanctum (`x: 2..6, y: 17..21`)
  set_wall_box(3, 14, 7, 16, 0);
  set_wall_box(2, 17, 6, 21, 0);
  mem_store(128 + map_idx(1, 19), 4);
  mem_store(128 + map_idx(7, 19), 4);
  // Final Glowing Violet-Gold Runic Exit Slipgate at `(4, 22)` + trigger pad at `(4, 21)`!
  mem_store(128 + map_idx(4, 22), 5);
  mem_store(128 + map_idx(3, 22), 3);
  mem_store(128 + map_idx(5, 22), 3);

  // Populate 8 Monsters (Kind 1 = Cyber-Grunt, Kind 2 = Horned Fiend Knight, Kind 3 = Dread Warden Boss)
  spawn_enemy(0, 9, 4, 1, 35);
  spawn_enemy(1, 15, 4, 1, 35);
  spawn_enemy(2, 14, 7, 2, 65);
  spawn_enemy(3, 10, 13, 1, 40);
  spawn_enemy(4, 17, 13, 2, 70);
  spawn_enemy(5, 13, 17, 1, 40);
  spawn_enemy(6, 5, 15, 2, 75);
  spawn_enemy(7, 4, 19, 3, 130); // Dread Slipgate Warden guarding the Exit Arch!

  // Populate 8 Pickups (1 = Medkit +30 HP, 2 = Buckshot Shells +8, 3 = Bronze Armor +50)
  spawn_item(0, 5, 2, 2);
  spawn_item(1, 14, 4, 3);
  spawn_item(2, 17, 5, 1);
  spawn_item(3, 9, 17, 2);
  spawn_item(4, 18, 17, 1);
  spawn_item(5, 14, 15, 2);
  spawn_item(6, 3, 15, 1);
  spawn_item(7, 6, 20, 2);
}

fn save_combat_snapshot() -[Mem]-> unit {
  let head = mem_load(16);
  let slot = if head < 0 { 0 } else { if head >= 120 { 0 } else { head } };
  let base = snap_addr(slot);

  let mut h = 0;
  while h < 16 max 16 {
    mem_store(base + h, mem_load(h));
    h = h + 1;
  }
  mem_store(base + 18, mem_load(18));

  let mut e = 0;
  while e >= 0 && e < 8 max 8 {
    let ea = enemy_addr(e);
    let da = base + 24 + e * 8;
    let mut f = 0;
    while f < 8 max 8 {
      mem_store(da + f, mem_load(ea + f));
      f = f + 1;
    }
    e = e + 1;
  }

  let mut it = 0;
  while it >= 0 && it < 8 max 8 {
    let ia = item_addr(it);
    mem_store(base + 96 + it, mem_load(ia + 3));
    it = it + 1;
  }

  let nxt = if slot + 1 >= 120 { 0 } else { slot + 1 };
  mem_store(16, nxt);
  let cnt = mem_load(17);
  if cnt < 120 {
    mem_store(17, cnt + 1);
  } else { () }
}

export fn init_game(seed: i64) -[Mem]-> i64 {
  let clean_seed = if seed <= 0 { 19960622 } else { seed & 0x7FFFFFFF };
  mem_store(0, 0);
  mem_store(1, 3 * 1024 + 512);
  mem_store(2, 4 * 1024 + 512);
  mem_store(3, 0); // Facing East down the Slipgate Bunker toward the corridor!
  mem_store(4, 100);
  mem_store(5, 25);
  mem_store(6, 24);
  mem_store(7, 0);
  mem_store(8, 0);
  mem_store(9, 0);
  mem_store(10, 0);
  mem_store(11, 0);
  mem_store(12, 0);
  mem_store(13, 0);
  mem_store(14, 0);
  mem_store(15, 0);
  mem_store(16, 0);
  mem_store(17, 0);
  mem_store(18, clean_seed);
  mem_store(19, 0);

  init_trig_tables();
  bake_procedural_textures();
  build_slipgate_level();
  save_combat_snapshot();
  render_3d_frame()
}

fn is_solid(wx: i64, wy: i64) -[Mem]-> bool {
  let tx = wx >> 10;
  let ty = wy >> 10;
  if tx < 0 || tx >= 24 || ty < 0 || ty >= 24 {
    true
  } else {
    mem_load(128 + map_idx(tx, ty)) > 0
  }
}

fn has_line_of_sight(x0: i64, y0: i64, x1: i64, y1: i64) -[Mem]-> bool {
  let mut ok = true;
  let mut s = 1;
  while s < 16 && ok max 16 {
    let mx = x0 + ((x1 - x0) * s) / 16;
    let my = y0 + ((y1 - y0) * s) / 16;
    if is_solid(mx, my) {
      ok = false;
    } else { () };
    s = s + 1;
  }
  ok
}

fn fire_double_shotgun(px: i64, py: i64, pang: i64) -[Mem]-> unit {
  let ammo = mem_load(6);
  if ammo > 0 && mem_load(10) == 0 {
    mem_store(6, ammo - 1);
    mem_store(9, 7);   // Dynamic orange muzzle-flash light!
    mem_store(10, 16); // Boomstick recoil + pump cycle
    mem_store(15, mem_load(15) | 1); // Bit 0: Double-Barrel Shotgun Boom!

    let dir_x = fast_cos(pang);
    let dir_y = fast_sin(pang);

    // Hitscan pellet cone check against all living enemies with line-of-sight!
    let mut best_e = -1;
    let mut best_dist = 999999;

    let mut e = 0;
    while e >= 0 && e < 8 max 8 {
      let ea = enemy_addr(e);
      if mem_load(ea + 4) != 2 {
        let ex = mem_load(ea);
        let ey = mem_load(ea + 1);
        let dx = ex - px;
        let dy = ey - py;
        let fwd = (dx * dir_x + dy * dir_y) / 1024;
        let lat = abs_val((-dx * dir_y + dy * dir_x) / 1024);
        // Wide buckshot spread cone (`lat < 360 + fwd / 7`)
        if fwd > 120 && fwd < 12000 && lat < 340 + fwd / 8 {
          if fwd < best_dist && has_line_of_sight(px, py, ex, ey) {
            best_dist = fwd;
            best_e = e;
          } else { () };
        } else { () };
      } else { () };
      e = e + 1;
    }

    if best_e >= 0 && best_e < 8 {
      let ta = enemy_addr(best_e);
      // Point-blank double-barrel blast deals massive meaty damage!
      let raw_dmg = 58 - best_dist / 220;
      let dmg = if raw_dmg < 22 { 22 } else { raw_dmg };
      let nhp = mem_load(ta + 3) - dmg;
      mem_store(ta + 6, 8); // Hit flash!
      mem_store(ta + 4, 1); // Aggro!
      if nhp <= 0 {
        mem_store(ta + 3, 0);
        mem_store(ta + 4, 2); // Dead!
        mem_store(7, mem_load(7) + 1);
        mem_store(15, mem_load(15) | 4); // Bit 2: Monster Death Roar!
      } else {
        mem_store(ta + 3, nhp);
        mem_store(15, mem_load(15) | 2); // Bit 1: Pellet Impact / Monster Pain!
      };
    } else { () };
  } else { () }
}

fn damage_player(raw_dmg: i64) -[Mem]-> unit {
  let arm = mem_load(5);
  let absorb = if arm > 0 { (raw_dmg * 3) / 5 } else { 0 };
  let actual_abs = if absorb > arm { arm } else { absorb };
  let hp_loss = raw_dmg - actual_abs;
  mem_store(5, arm - actual_abs);
  let nhp = clamp_stat(mem_load(4) - hp_loss, 100);
  mem_store(4, nhp);
  mem_store(11, 9);
  mem_store(15, mem_load(15) | 16); // Bit 4: Player Hurt Grunt!
  if nhp <= 0 {
    mem_store(14, 2);
  } else { () }
}

export fn step_fps(
  move_fwd: i64,
  move_strafe: i64,
  turn_delta: i64,
  fire_in: i64
) -[Mem]-> i64 {
  let state = mem_load(14);
  if state != 0 {
    render_3d_frame()
  } else {
    let tick = mem_load(0) + 1;
    mem_store(0, tick);

    if mem_load(9) > 0 { mem_store(9, mem_load(9) - 1); } else { () };
    if mem_load(10) > 0 { mem_store(10, mem_load(10) - 1); } else { () };
    if mem_load(11) > 0 { mem_store(11, mem_load(11) - 1); } else { () };
    if mem_load(12) > 0 { mem_store(12, mem_load(12) - 1); } else { () };

    let pang = (mem_load(3) + turn_delta) & 1023;
    mem_store(3, pang);

    let dir_x = fast_cos(pang);
    let dir_y = fast_sin(pang);
    let str_x = -dir_y;
    let str_y = dir_x;

    let spd = 82;
    let vx = (move_fwd * dir_x * spd + move_strafe * str_x * spd) / 1024;
    let vy = (move_fwd * dir_y * spd + move_strafe * str_y * spd) / 1024;

    let mut px = mem_load(1);
    let mut py = mem_load(2);
    let pad = if vx >= 0 { 240 } else { -240 };
    if !is_solid(px + vx + pad, py - 200) && !is_solid(px + vx + pad, py + 200) {
      px = px + vx;
    } else { () };
    let pady = if vy >= 0 { 240 } else { -240 };
    if !is_solid(px - 200, py + vy + pady) && !is_solid(px + 200, py + vy + pady) {
      py = py + vy;
    } else { () };

    mem_store(1, px);
    mem_store(2, py);

    if move_fwd != 0 || move_strafe != 0 {
      let nbob = (mem_load(13) + 3) & 63;
      mem_store(13, nbob);
      if (nbob & 15) == 0 {
        mem_store(15, mem_load(15) | 64); // Bit 6: Metal Grate Footstep!
      } else { () };
    } else { () };

    // Check Exit Slipgate Victory Pad (`tile (4, 21)` right in front of the Glowing Arch `(4, 22)`)!
    let ptx = px >> 10;
    let pty = py >> 10;
    if ptx >= 3 && ptx <= 5 && pty >= 21 {
      mem_store(14, 1);
      mem_store(15, mem_load(15) | 128); // Bit 7: Slipgate Warp Victory!
    } else { () };

    // Check Radioactive Slime floor hazard!
    if ptx >= 0 && ptx < 24 && pty >= 0 && pty < 24 {
      if mem_load(704 + map_idx(ptx, pty)) == 1 && (tick & 31) == 0 {
        damage_player(5);
      } else { () };
    } else { () };

    // Check Pickups (Medkits, Shells, Bronze Armor)
    let mut it = 0;
    while it >= 0 && it < 8 max 8 {
      let ia = item_addr(it);
      if mem_load(ia + 3) == 1 {
        let ix = mem_load(ia);
        let iy = mem_load(ia + 1);
        if abs_val(ix - px) < 520 && abs_val(iy - py) < 520 {
          let ikind = mem_load(ia + 2);
          if ikind == 1 && mem_load(4) < 100 {
            mem_store(4, clamp_stat(mem_load(4) + 30, 100));
            mem_store(ia + 3, 0);
            mem_store(12, 8);
            mem_store(15, mem_load(15) | 32);
          } else {
            if ikind == 2 {
              mem_store(6, clamp_stat(mem_load(6) + 8, 99));
              mem_store(ia + 3, 0);
              mem_store(12, 8);
              mem_store(15, mem_load(15) | 32);
            } else {
              if ikind == 3 && mem_load(5) < 100 {
                mem_store(5, clamp_stat(mem_load(5) + 50, 100));
                mem_store(ia + 3, 0);
                mem_store(12, 8);
                mem_store(15, mem_load(15) | 32);
              } else { () };
            };
          };
        } else { () };
      } else { () };
      it = it + 1;
    }

    if fire_in > 0 {
      fire_double_shotgun(px, py, pang);
    } else { () };

    // Step Monster AI (Sight Aggro, Chase, Ranged Plasma / Melee Slash)
    let mut e = 0;
    while e >= 0 && e < 8 max 8 {
      let ea = enemy_addr(e);
      if mem_load(ea + 6) > 0 {
        mem_store(ea + 6, mem_load(ea + 6) - 1);
      } else { () };

      let est = mem_load(ea + 4);
      if est != 2 {
        let ex = mem_load(ea);
        let ey = mem_load(ea + 1);
        let dx = px - ex;
        let dy = py - ey;
        let dist_approx = abs_val(dx) + abs_val(dy);

        if est == 0 && dist_approx < 7500 {
          if has_line_of_sight(ex, ey, px, py) {
            mem_store(ea + 4, 1);
          } else { () };
        } else { () };

        if mem_load(ea + 4) == 1 {
          mem_store(ea + 7, (mem_load(ea + 7) + 1) & 31);
          let ekind = mem_load(ea + 2);
          let espd = if ekind == 2 { 42 } else { 28 };
          if dist_approx > 850 && dist_approx > 0 {
            let step_x = (dx * espd) / dist_approx;
            let step_y = (dy * espd) / dist_approx;
            if !is_solid(ex + step_x * 4, ey) {
              mem_store(ea, ex + step_x);
            } else { () };
            if !is_solid(mem_load(ea), ey + step_y * 4) {
              mem_store(ea + 1, ey + step_y);
            } else { () };
          } else { () };

          let cd = mem_load(ea + 5) - 1;
          if cd <= 0 {
            if dist_approx < 6800 && has_line_of_sight(ex, ey, px, py) {
              let r = next_rand();
              mem_store(15, mem_load(15) | 8); // Bit 3: Enemy Shot!
              if (r & 3) != 0 {
                let hit_dmg = if ekind == 3 { 16 } else { if ekind == 2 { 12 } else { 8 } };
                damage_player(hit_dmg);
              } else { () };
            } else { () };
            mem_store(ea + 5, if ekind == 3 { 38 } else { 52 });
          } else {
            mem_store(ea + 5, cd);
          };
        } else { () };
      } else { () };
      e = e + 1;
    }

    let safe_kills = clamp_stat(mem_load(7), 8);
    let safe_hp = clamp_stat(mem_load(4), 100);
    let win_b = if mem_load(14) == 1 { 1000 } else { 0 };
    mem_store(8, compute_fps_score(safe_kills, safe_hp, win_b));

    if (tick & 3) == 0 {
      save_combat_snapshot();
    } else { () };

    render_3d_frame()
  }
}

export fn rewind_combat(steps_back: i64) -[Mem]-> i64 {
  let cnt = mem_load(17);
  if cnt <= 0 {
    render_3d_frame()
  } else {
    let clamped = if steps_back < 0 { 0 } else { if steps_back >= cnt { cnt - 1 } else { steps_back } };
    let raw = mem_load(16) - 1 - clamped;
    let wrapped = if raw < 0 { raw + 120 } else { raw };
    let slot = if wrapped < 0 { 0 } else { if wrapped >= 120 { 0 } else { wrapped } };
    let base = snap_addr(slot);

    let mut h = 0;
    while h < 15 max 15 {
      mem_store(h, mem_load(base + h));
      h = h + 1;
    }
    mem_store(18, mem_load(base + 18));

    let mut e = 0;
    while e >= 0 && e < 8 max 8 {
      let ea = enemy_addr(e);
      let da = base + 24 + e * 8;
      let mut f = 0;
      while f < 8 max 8 {
        mem_store(ea + f, mem_load(da + f));
        f = f + 1;
      }
      e = e + 1;
    }

    let mut it = 0;
    while it >= 0 && it < 8 max 8 {
      let ia = item_addr(it);
      mem_store(ia + 3, mem_load(base + 96 + it));
      it = it + 1;
    }

    render_3d_frame()
  }
}

// --- Widescreen 720x450 Quake-Palette 3D Software Engine ---

fn shade_texel(texel: i64, light: i64, muz_glow: i64) -> i64 {
  let r = (((texel & 255) * light) >> 8) + muz_glow;
  let g = ((((texel >> 8) & 255) * light) >> 8) + (muz_glow * 2) / 3;
  let b = ((((texel >> 16) & 255) * light) >> 8) + muz_glow / 4;
  pack_rgba(r, g, b)
}

fn draw_billboard_sprite(
  px: i64,
  py: i64,
  dir_x: i64,
  dir_y: i64,
  plane_x: i64,
  plane_y: i64,
  horizon: i64,
  sx_w: i64,
  sy_w: i64,
  kind: i64,
  state: i64,
  hit_flash: i64,
  anim: i64
) -[Mem]-> unit {
  let rel_x = sx_w - px;
  let rel_y = sy_w - py;

  // Inverse camera matrix (`det = plane_x * dir_y - dir_x * plane_y ≈ 720 * 1024`)
  let tz = (rel_x * dir_x + rel_y * dir_y) / 1024;
  if tz > 180 && tz < 14000 {
    let tx_cam = (-rel_x * dir_y + rel_y * dir_x) / 1024;
    let scr_x = 360 + (tx_cam * 500) / tz;
    let spr_h = (420 * 1024) / tz;
    let spr_w = if kind >= 10 { spr_h / 2 } else { (spr_h * 3) / 4 };

    let y_bot = horizon + spr_h / 2;
    let y_top = if state == 2 { y_bot - spr_h / 4 } else { y_bot - spr_h };
    let x_left = scr_x - spr_w / 2;
    let x_right = scr_x + spr_w / 2;

    let light = clamp_stat(250 - tz / 48, 255);
    let cl_x0 = if x_left < 0 { 0 } else { x_left };
    let cl_x1 = if x_right > 719 { 719 } else { x_right };
    let cl_y0 = if y_top < 0 { 0 } else { y_top };
    let cl_y1 = if y_bot > 396 { 396 } else { y_bot };

    if spr_w > 2 && spr_h > 2 && cl_x0 <= cl_x1 && cl_y0 <= cl_y1 {
      let mut sx = cl_x0;
      while sx <= cl_x1 max 720 {
        if tz < mem_load(3200 + sx) {
          let u = ((sx - x_left) * 64) / spr_w; // 0..63
          let du = abs_val(u - 32);

          let mut sy = cl_y0;
          while sy <= cl_y1 max 400 {
            let v = ((sy - y_top) * 64) / (if y_bot - y_top > 0 { y_bot - y_top } else { 1 });
            if kind >= 10 {
              // 3D Pickup Crate / Medkit / Bronze Armor Shield!
              let ik = kind - 10;
              let dv = abs_val(v - 42);
              if du < 18 && v >= 24 && v <= 60 {
                let shade_3d = (light * (240 - du * 4)) >> 8;
                let cross = (du < 4 && dv < 10) || (du < 10 && dv < 4);
                let pr = if ik == 1 { if cross { 235 } else { 220 } } else { if ik == 2 { 172 } else { 218 } };
                let pg = if ik == 1 { if cross { 42 } else { 222 } } else { if ik == 2 { 134 } else { 156 } };
                let pb = if ik == 1 { if cross { 42 } else { 216 } } else { if ik == 2 { 56 } else { 52 } };
                mem_store(65536 + sy * 720 + sx, shade_texel(pack_rgba(pr, pg, pb), shade_3d, 0));
              } else { () };
            } else {
              if state == 2 {
                // Fallen Monster Corpse Mound
                if du * du + (v - 40) * (v - 40) < 620 {
                  mem_store(65536 + sy * 720 + sx, shade_texel(pack_rgba(116, 38, 32), light, 0));
                } else { () };
              } else {
                // Sculpted 3D Cylindrical Shaded Monster Silhouette (Grunt / Horned Fiend / Dread Warden)!
                let stride = ((anim >> 2) & 3) - 1;
                let in_head = v >= 4 && v < 18 && du < 9;
                let horns = kind >= 2 && v >= 1 && v < 10 && du >= 8 && du <= 14;
                let in_torso = v >= 18 && v < 42 && du < (if kind == 3 { 20 } else { 16 });
                let in_arms = v >= 20 && v < 38 && du >= 14 && du < 24;
                let in_legs = v >= 42 && v <= 62 && ((u >= 16 + stride && u <= 27 + stride) || (u >= 37 - stride && u <= 48 - stride));

                if in_head || horns || in_torso || in_arms || in_legs {
                  let cyl = 250 - du * 5;
                  let m_light = (light * cyl) >> 8;
                  let visor = in_head && v >= 9 && v <= 12 && du < 6;
                  let gun_flash = (mem_load(0) & 7) == 0 && in_arms && v >= 28 && v <= 34;

                  let mut mr = if kind == 1 { 112 } else { if kind == 2 { 148 } else { 168 } };
                  let mut mg = if kind == 1 { 104 } else { if kind == 2 { 78 } else { 52 } };
                  let mut mb = if kind == 1 { 86 } else { if kind == 2 { 54 } else { 68 } };

                  if horns { mr = 212; mg = 188; mb = 142; } else { () };
                  if visor {
                    mr = 255;
                    mg = if kind == 3 { 70 } else { 165 };
                    mb = if kind == 3 { 220 } else { 32 };
                  } else { () };
                  if gun_flash { mr = 255; mg = 210; mb = 80; } else { () };

                  let fl = hit_flash * 24;
                  let lit = if visor || gun_flash { 255 } else { m_light };
                  mem_store(65536 + sy * 720 + sx, shade_texel(pack_rgba(mr, mg, mb), lit, fl));
                } else { () };
              };
            };
            sy = sy + 1;
          }
        } else { () };
        sx = sx + 1;
      }
    } else { () };
  } else { () }
}

fn draw_double_shotgun_viewmodel(recoil: i64, muzzle: i64, bob_x: i64, bob_y: i64) -[Mem]-> unit {
  let kick_y = recoil * 3 + bob_y;
  let cx = 360 + bob_x;

  // 1. Fiery Multi-Spike Muzzle Blast when firing!
  if muzzle > 2 {
    let rad = muzzle * 9;
    let mut my = -rad;
    while my <= rad max 130 {
      let py = 278 + kick_y + my;
      if py >= 120 && py < 396 {
        let mut mx = -rad;
        while mx <= rad max 130 {
          let px = cx + mx;
          if px >= 160 && px < 560 {
            let d2 = mx * mx + my * my;
            let spike = ((mx * 7 ^ my * 13) & 15) * 24;
            if d2 < rad * rad - spike {
              let core = d2 < (rad * rad) / 4;
              let fr = 255;
              let fg = if core { 248 } else { 168 };
              let fb = if core { 165 } else { 38 };
              mem_store(65536 + py * 720 + px, pack_rgba(fr, fg, fb));
            } else { () };
          } else { () };
          mx = mx + 1;
        }
      } else { () };
      my = my + 1;
    }
  } else { () };

  // 2. Iconic Center-Aligned Twin Cylindrical Steel Barrels + Walnut Stock (`y: 288..396`)
  let mut y = 286 + kick_y;
  while y < 396 max 120 {
    if y >= 200 && y < 396 {
      let t = y - (286 + kick_y); // 0 at muzzle -> 110 at stock
      let half_w = 18 + (t * 28) / 110;
      let barrel_sep = 8 + (t * 10) / 110;
      let brl_rad = 8 + (t * 6) / 110;

      let mut dx = -half_w;
      while dx <= half_w max 110 {
        let px = cx + dx;
        if px >= 0 && px < 720 {
          if t > 74 {
            // Carved Walnut Fore-end & Receiver with Brass Shells during pump!
            let wood_sh = 180 - abs_val(dx) * 3;
            let wr = (138 * wood_sh) >> 8;
            let wg = (78 * wood_sh) >> 8;
            let wb = (42 * wood_sh) >> 8;
            mem_store(65536 + y * 720 + px, pack_rgba(wr, wg, wb));
          } else {
            // Left & Right 3D Cylindrical Blued-Steel Shotgun Barrels with Specular Ridge!
            let d_left = abs_val(dx + barrel_sep);
            let d_right = abs_val(dx - barrel_sep);
            let min_d = if d_left < d_right { d_left } else { d_right };
            if min_d <= brl_rad {
              let bore = t < 5 && min_d < brl_rad - 3;
              if bore {
                mem_store(65536 + y * 720 + px, pack_rgba(18, 16, 16));
              } else {
                let spec = 220 - min_d * 14 + (if dx < 0 { 24 } else { -12 });
                let sr = ((94 * spec) >> 8) + muzzle * 8;
                let sg = ((98 * spec) >> 8) + muzzle * 5;
                let sb = ((108 * spec) >> 8) + muzzle * 2;
                mem_store(65536 + y * 720 + px, pack_rgba(sr, sg, sb));
              };
            } else {
              // Center ventilated rib between twin barrels
              if abs_val(dx) <= 3 {
                mem_store(65536 + y * 720 + px, pack_rgba(52, 54, 60));
              } else { () };
            };
          };
        } else { () };
        dx = dx + 1;
      }
    } else { () };
    y = y + 1;
  }
}

export fn render_3d_frame() -[Mem]-> i64 {
  let tick = mem_load(0);
  let px = mem_load(1);
  let py = mem_load(2);
  let pang = mem_load(3);
  let hp = mem_load(4);
  let arm = mem_load(5);
  let ammo = mem_load(6);
  let muzzle = mem_load(9);
  let recoil = mem_load(10);
  let hurt = mem_load(11);
  let pickup = mem_load(12);
  let bob_t = mem_load(13);

  let dir_x = fast_cos(pang);
  let dir_y = fast_sin(pang);
  // 75-degree widescreen FOV camera plane (`plane = 0.72 * perp(dir)`)
  let plane_x = (-dir_y * 720) / 1024;
  let plane_y = (dir_x * 720) / 1024;

  let bob_sin = fast_sin(bob_t * 16);
  let horizon = 198 + (bob_sin * 5) / 1024;
  let gun_bob_x = (fast_cos(bob_t * 8) * 8) / 1024;
  let gun_bob_y = abs_val((bob_sin * 6) / 1024);

  let ptx = clamp_stat(px >> 10, 23);
  let pty = clamp_stat(py >> 10, 23);
  let in_open_sky = mem_load(704 + map_idx(ptx, pty)) == 2;

  // 1. Constant-Z Perspective Textured Floor & Ceiling Scanlines (`y: 0..396`)
  let rdx0 = dir_x - plane_x;
  let rdy0 = dir_y - plane_y;
  let rdx1 = dir_x + plane_x;
  let rdy1 = dir_y + plane_y;

  let mut y = 0;
  while y < 396 max 396 {
    let row_off = 65536 + y * 720;
    let is_floor = y >= horizon;
    let p_dy = if is_floor { y - horizon + 1 } else { horizon - y + 1 };
    let raw_rd = (198 * 1024) / p_dy;
    let row_dist = if raw_rd < 1 { 1 } else { raw_rd };

    let base_l = clamp_stat(242 - row_dist / 36, 255);
    let muz_l = if muzzle > 0 { (muzzle * 24 * 1024) / (row_dist + 512) } else { 0 };

    if !is_floor && in_open_sky {
      // Scrolling Dark Quake-1 Purple/Indigo Tempest Sky!
      let mut sx = 0;
      while sx < 720 max 720 {
        let su = ((sx + pang * 2 + tick) >> 2) & 63;
        let sv = ((y + (tick >> 1)) >> 1) & 63;
        let cloud = mem_load(tex_addr(7, su, sv));
        mem_store(row_off + sx, shade_texel(cloud, 215, muz_l / 2));
        sx = sx + 1;
      }
    } else {
      let mut fx = px * 64 + ((row_dist * rdx0) / 16);
      let mut fy = py * 64 + ((row_dist * rdy0) / 16);
      let step_x = (row_dist * (rdx1 - rdx0)) / (720 * 16);
      let step_y = (row_dist * (rdy1 - rdy0)) / (720 * 16);

      let mut sx = 0;
      while sx < 720 max 720 {
        let cell_x = fx >> 16;
        let cell_y = fy >> 16;
        let u = (fx >> 10) & 63;
        let v = (fy >> 10) & 63;

        let mut tid = if is_floor { 5 } else { 7 };
        let mut l_val = base_l;
        if is_floor && cell_x >= 0 && cell_x < 24 && cell_y >= 0 && cell_y < 24 {
          if mem_load(704 + map_idx(cell_x, cell_y)) == 1 {
            tid = 6; // Swirling glowing green acid slime!
            let su = (u + (tick >> 1)) & 63;
            let sv = (v + (tick >> 2)) & 63;
            let slime_px = mem_load(tex_addr(6, su, sv));
            mem_store(row_off + sx, shade_texel(slime_px, 235, muz_l));
            tid = -1;
          } else { () };
        } else { () };

        if tid >= 0 && tid < 8 {
          let tpx = mem_load(tex_addr(tid, u, v));
          mem_store(row_off + sx, shade_texel(tpx, l_val, muz_l));
        } else { () };

        fx = fx + step_x;
        fy = fy + step_y;
        sx = sx + 1;
      }
    };
    y = y + 1;
  }

  // 2. 720-Column Textured DDA Wall Raycaster + Dynamic Torch & Muzzle Lighting!
  let mut x = 0;
  while x < 720 max 720 {
    let rdx = dir_x + ((plane_x * (x - 360)) / 360);
    let rdy = dir_y + ((plane_y * (x - 360)) / 360);

    let mut map_x = px >> 10;
    let mut map_y = py >> 10;

    let arx = abs_val(rdx);
    let ary = abs_val(rdy);
    let abs_rdx = if arx <= 0 { 1 } else { arx };
    let abs_rdy = if ary <= 0 { 1 } else { ary };
    let ddx = 1048576 / abs_rdx;
    let ddy = 1048576 / abs_rdy;

    let step_mx = if rdx < 0 { -1 } else { 1 };
    let step_my = if rdy < 0 { -1 } else { 1 };

    let mut side_dx = if rdx < 0 { ((px & 1023) * ddx) >> 10 } else { ((1024 - (px & 1023)) * ddx) >> 10 };
    let mut side_dy = if rdy < 0 { ((py & 1023) * ddy) >> 10 } else { ((1024 - (py & 1023)) * ddy) >> 10 };

    let mut hit = 0;
    let mut side = 0;
    let mut steps = 0;
    while hit == 0 && steps < 38 max 38 {
      if side_dx < side_dy {
        side_dx = side_dx + ddx;
        map_x = map_x + step_mx;
        side = 0;
      } else {
        side_dy = side_dy + ddy;
        map_y = map_y + step_my;
        side = 1;
      };
      if map_x < 0 || map_x >= 24 || map_y < 0 || map_y >= 24 {
        hit = 2;
      } else {
        hit = mem_load(128 + map_idx(map_x, map_y));
      };
      steps = steps + 1;
    }

    let raw_perp = if side == 0 { side_dx - ddx } else { side_dy - ddy };
    let perp = if raw_perp < 64 { 64 } else { raw_perp };
    mem_store(3200 + x, perp);

    let line_h = (396 * 1024) / perp;
    let y0 = horizon - line_h / 2;
    let y1 = horizon + line_h / 2;
    let cy0 = if y0 < 0 { 0 } else { y0 };
    let cy1 = if y1 > 395 { 395 } else { y1 };

    let wall_hit = if side == 0 { py + (perp * rdy) / 1024 } else { px + (perp * rdx) / 1024 };
    let mut tex_u = (wall_hit >> 4) & 63;
    if hit == 5 {
      // Animate swirling Runic Exit Slipgate!
      tex_u = (tex_u + (tick >> 1)) & 63;
    } else { () };

    let tid = if hit >= 1 && hit <= 5 { hit - 1 } else { 0 };
    let side_mul = if side == 1 { 196 } else { 256 };
    let mut col_light = ((clamp_stat(252 - perp / 40, 255) * side_mul) >> 8);
    if hit == 4 {
      // Flickering Torch Brazier self-illumination!
      col_light = clamp_stat(col_light + 95 + (((tick >> 1) * 13) & 31), 255);
    } else {
      if hit == 5 {
        col_light = 250; // Glowing Runic Exit Slipgate!
      } else { () };
    };
    let muz_wall = if muzzle > 0 { (muzzle * 28 * 1024) / (perp + 400) } else { 0 };

    if line_h > 0 {
      let mut wy = cy0;
      while wy <= cy1 max 396 {
        let tex_v = (((wy - y0) * 64) / line_h) & 63;
        let tcol = mem_load(tex_addr(tid, tex_u, tex_v));
        mem_store(65536 + wy * 720 + x, shade_texel(tcol, col_light, muz_wall));
        wy = wy + 1;
      }
    } else { () };

    x = x + 1;
  }

  // 3. Render Pickups (Medkits, Shells, Bronze Armor)
  let mut it = 0;
  while it >= 0 && it < 8 max 8 {
    let ia = item_addr(it);
    if mem_load(ia + 3) == 1 {
      draw_billboard_sprite(
        px, py, dir_x, dir_y, plane_x, plane_y, horizon,
        mem_load(ia), mem_load(ia + 1), 10 + mem_load(ia + 2), 0, 0, 0
      );
    } else { () };
    it = it + 1;
  }

  // 4. Depth-Sort & Render all 8 3D Shaded Monsters (far-to-near painter + Z-buffer clip!)
  let mut ei = 0;
  while ei >= 0 && ei < 8 max 8 {
    let ea = enemy_addr(ei);
    let dx = mem_load(ea) - px;
    let dy = mem_load(ea + 1) - py;
    mem_store(3920 + ei, ei);
    mem_store(3928 + ei, abs_val(dx) + abs_val(dy));
    ei = ei + 1;
  }

  let mut sp = 0;
  while sp < 8 max 8 {
    let mut sq = 0;
    while sq < 7 max 7 {
      let d0 = mem_load(3928 + sq);
      let d1 = mem_load(3928 + sq + 1);
      if d0 < d1 {
        let id0 = mem_load(3920 + sq);
        let id1 = mem_load(3920 + sq + 1);
        mem_store(3928 + sq, d1);
        mem_store(3928 + sq + 1, d0);
        mem_store(3920 + sq, id1);
        mem_store(3920 + sq + 1, id0);
      } else { () };
      sq = sq + 1;
    }
    sp = sp + 1;
  }

  let mut di = 0;
  while di < 8 max 8 {
    let eid = mem_load(3920 + di);
    if eid >= 0 && eid < 8 {
      let ea = enemy_addr(eid);
      draw_billboard_sprite(
        px, py, dir_x, dir_y, plane_x, plane_y, horizon,
        mem_load(ea), mem_load(ea + 1), mem_load(ea + 2),
        mem_load(ea + 4), mem_load(ea + 6), mem_load(ea + 7)
      );
    } else { () };
    di = di + 1;
  }

  // 5. Center Crosshair + Iconic Quake-Style Twin-Barrel Shotgun Viewmodel!
  let ch_col = pack_rgba(245, 204, 68);
  mem_store(65536 + horizon * 720 + 356, ch_col);
  mem_store(65536 + horizon * 720 + 357, ch_col);
  mem_store(65536 + horizon * 720 + 363, ch_col);
  mem_store(65536 + horizon * 720 + 364, ch_col);
  mem_store(65536 + (horizon - 4) * 720 + 360, ch_col);
  mem_store(65536 + (horizon + 4) * 720 + 360, ch_col);

  draw_double_shotgun_viewmodel(recoil, muzzle, gun_bob_x, gun_bob_y);

  // 6. Industrial Riveted Bronze Status Bar (`y: 396..450`) + Automap Minimap in Corner!
  let mut by = 396;
  while by < 450 max 56 {
    let brow = 65536 + by * 720;
    let mut bx = 0;
    while bx < 720 max 720 {
      let bevel = if by == 396 { 96 } else { if by == 397 { 78 } else { 44 - (by - 396) / 3 } };
      let mut hr = bevel + 8;
      let mut hg = bevel;
      let mut hb = bevel - 6;

      // Health Gauge (`x: 36..216, y: 414..434`)
      if by >= 414 && by <= 434 && bx >= 36 && bx < 216 {
        let h_fill = (bx - 36) < (hp * 180) / 100;
        hr = if h_fill { if hp <= 25 { 235 } else { 198 } } else { 24 };
        hg = if h_fill { if hp <= 25 { 42 } else { 52 } } else { 20 };
        hb = if h_fill { 42 } else { 22 };
      } else { () };

      // Bronze Armor Gauge (`x: 268..448, y: 414..434`)
      if by >= 414 && by <= 434 && bx >= 268 && bx < 448 {
        let a_fill = (bx - 268) < (arm * 180) / 100;
        hr = if a_fill { 218 } else { 24 };
        hg = if a_fill { 158 } else { 20 };
        hb = if a_fill { 48 } else { 22 };
      } else { () };

      // Buckshot Shells Gauge (`x: 500..680, y: 414..434`)
      if by >= 414 && by <= 434 && bx >= 500 && bx < 680 {
        let s_fill = (bx - 500) < (ammo * 180) / 40;
        hr = if s_fill { 232 } else { 24 };
        hg = if s_fill { 196 } else { 20 };
        hb = if s_fill { 76 } else { 22 };
      } else { () };

      mem_store(brow + bx, (255 << 24) | (hb << 16) | (hg << 8) | hr);
      bx = bx + 1;
    }
    by = by + 1;
  }

  // Top-left Tactical Radar Minimap (`24x24` * 3px = `72x72` at `(12, 12)`)
  let mut my_m = 0;
  while my_m >= 0 && my_m < 24 max 24 {
    let mut mx_m = 0;
    while mx_m >= 0 && mx_m < 24 max 24 {
      let wt = mem_load(128 + map_idx(mx_m, my_m));
      let ft = mem_load(704 + map_idx(mx_m, my_m));
      let mcol = if mx_m == ptx && my_m == pty {
        pack_rgba(255, 240, 80)
      } else {
        if wt == 5 {
          pack_rgba(210, 90, 255)
        } else {
          if wt > 0 {
            pack_rgba(92, 82, 72)
          } else {
            if ft == 1 { pack_rgba(46, 156, 52) } else { pack_rgba(24, 28, 34) }
          }
        }
      };
      let sx0 = 12 + mx_m * 3;
      let sy0 = 12 + my_m * 3;
      mem_store(65536 + sy0 * 720 + sx0, mcol);
      mem_store(65536 + sy0 * 720 + sx0 + 1, mcol);
      mem_store(65536 + (sy0 + 1) * 720 + sx0, mcol);
      mem_store(65536 + (sy0 + 1) * 720 + sx0 + 1, mcol);
      mx_m = mx_m + 1;
    }
    my_m = my_m + 1;
  }

  // Screen Hurt / Pickup Flash Border Vignette
  if hurt > 0 || pickup > 0 {
    let vr = if hurt > 0 { 220 } else { 240 };
    let vg = if hurt > 0 { 28 } else { 198 };
    let vb = if hurt > 0 { 28 } else { 64 };
    let vcol = pack_rgba(vr, vg, vb);
    let mut vx_i = 0;
    while vx_i < 720 max 720 {
      mem_store(65536 + vx_i, vcol);
      mem_store(65536 + 720 + vx_i, vcol);
      mem_store(65536 + 394 * 720 + vx_i, vcol);
      mem_store(65536 + 395 * 720 + vx_i, vcol);
      vx_i = vx_i + 1;
    }
  } else { () };

  262144
}

// --- Exported Telemetry & Sound Event Bitmask Getters ---

export fn get_fb_byte_offset() -> i64
  ens result == 262144
{
  262144
}

export fn pop_sfx() -[Mem]-> i64 {
  let m = mem_load(15);
  mem_store(15, 0);
  m
}

export fn get_health() -[Mem]-> i64 {
  mem_load(4)
}

export fn get_armor() -[Mem]-> i64 {
  mem_load(5)
}

export fn get_ammo() -[Mem]-> i64 {
  mem_load(6)
}

export fn get_kills() -[Mem]-> i64 {
  mem_load(7)
}

export fn get_score() -[Mem]-> i64 {
  mem_load(8)
}

export fn get_state() -[Mem]-> i64 {
  mem_load(14)
}

export fn get_tick() -[Mem]-> i64 {
  mem_load(0)
}

export fn get_snap_count() -[Mem]-> i64 {
  mem_load(17)
}

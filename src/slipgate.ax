// ============================================================================
// AXIOM SLIPGATE v2.0 GPU HD — True 3D Polygonal Engine (Axiom.Strata + Gpu)
// 100% Clean-Room Original IP • Written 100% in Axiom (Telos + Flux + Strata)
// Builds 256x256 Worley/FBM Bump-Mapped Textures, Multi-Level 3D Architecture,
// Slatted Sky Bridges, Diagonal Timber Rafters, 3D Shambler/Knight/Grunt Meshes
// & 3D Twin-Barrel Super-Shotgun directly in Linear Memory — ZERO rustc!
// ============================================================================

// --- Layer 1: Axiom.Telos Mathematically Verified Pure Kernels (Z3 SMT) ---

fn clamp_byte(v: i64) -> i64
  ens result >= 0 && result <= 255
{
  if v < 0 {
    0
  } else {
    if v > 255 { 255 } else { v }
  }
}

fn clamp_stat(v: i64, max_v: i64) -> i64
  req max_v >= 0
  ens result >= 0 && result <= max_v
{
  if v < 0 {
    0
  } else {
    if v > max_v { max_v } else { v }
  }
}

fn clamp_pitch(p: i64) -> i64
  ens result >= -700 && result <= 700
{
  if p < -700 {
    -700
  } else {
    if p > 700 { 700 } else { p }
  }
}

fn abs_val(v: i64) -> i64
  ens result >= 0
{
  if v < 0 { -v } else { v }
}

fn isqrt_24bit(n: i64) -> i64
  ens result >= 0
{
  if n <= 0 {
    0
  } else {
    let mut x = n;
    let mut res = 0;
    let mut bit = 16777216;
    while bit > x max 14 {
      bit = bit >> 2;
    }
    while bit > 0 max 14 {
      if x >= res + bit {
        x = x - (res + bit);
        res = (res >> 1) + bit;
      } else {
        res = res >> 1;
      };
      bit = bit >> 2;
    }
    if res < 0 { 0 } else { res }
  }
}

fn tex256_addr(tid: i64, tx: i64, ty: i64) -> i64
  req tid >= 0 && tid < 8
{
  65536 + tid * 65536 + ((ty & 255) << 8) + (tx & 255)
}

fn enemy_addr(eid: i64) -> i64
  req eid >= 0 && eid < 10
  ens result >= 6000 && result < 6200
{
  6000 + eid * 16
}

fn item_addr(iid: i64) -> i64
  req iid >= 0 && iid < 10
  ens result >= 6500 && result < 6600
{
  6500 + iid * 8
}

fn snap_addr(slot: i64) -> i64
  req slot >= 0 && slot < 120
  ens result >= 10000 && result < 45000
{
  10000 + slot * 240
}

fn compute_fps_score(kills: i64, hp_left: i64, slipgate_bonus: i64) -> i64
  req kills >= 0 && kills <= 10 && hp_left >= 0 && hp_left <= 100 && slipgate_bonus >= 0 && slipgate_bonus <= 1500
  ens result >= 0 && result <= 5000
{
  kills * 250 + hp_left * 5 + slipgate_bonus
}

fn pack_rgba_h(r: i64, g: i64, b: i64, h: i64) -> i64 {
  let cr = clamp_byte(r);
  let cg = clamp_byte(g);
  let cb = clamp_byte(b);
  let ch = clamp_byte(h);
  (ch << 24) | (cb << 16) | (cg << 8) | cr
}

fn pack_norm(nx: i64, ny: i64, nz: i64) -> i64 {
  let bx = clamp_byte(nx + 128);
  let by = clamp_byte(ny + 128);
  let bz = clamp_byte(nz + 128);
  bx | (by << 8) | (bz << 16)
}

// --- Layer 3: Axiom.Strata 8 MiB Linear Memory Layout ---
//   0: tick             1: cam_x            2: cam_y            3: cam_z
//   4: yaw (0..4095)    5: pitch (-700..700) 6: foot_y          7: vel_y
//   8: health           9: armor           10: ammo            11: kills
//  12: score           13: muzzle_timer    14: recoil_timer    15: hurt_flash
//  16: pickup_flash    17: bob_phase       18: game_state      19: sfx_mask
//  20: static_v_cnt    21: dyn_v_cnt       22: gun_v_cnt       23: light_cnt
//  24: snap_head       25: snap_count      26: rng_state       27: on_ground
//  28: sector_cnt      29: wall_box_cnt
// 512..4607:     4096-entry Sine Table (-1024..1024)
// 5000..5399:    Walkable Floor/Stair/Bridge Sectors (50 * 8 words: x0, z0, x1, z1, floor_y, ceil_y, kind, pad)
// 5400..5959:    Solid 3D Wall/Pillar Colliders (70 * 8 words: x0, z0, x1, z1, y0, y1, pad, pad)
// 6000..6159:    10 Articulated 3D Monsters * 16 words (x, y, z, kind, hp, state, cd, flash, anim, yaw, start_y, pad...)
// 6500..6579:    10 3D Pickups * 8 words (x, y, z, kind, active)
// 6800..7311:    64 3D Particles * 8 words (x, y, z, vx, vy, vz, rgb, life)
// 8000..8191:    24 Dynamic 3D Point Lights * 8 words (x, y, z, radius, r, g, b, flicker)
// 10000..38799:  120 Combat Time-Travel Snapshots * 240 words
// 65536..589823: 8 Procedural 256x256 Albedo+Heightmap Textures (byte offset 262,144; 2 MiB)
// 600000..1399999: Static 3D World Vertex Buffer (8 words = 32 bytes/vertex; byte offset 2,400,000)
// 1400000..1849999: Dynamic 3D Monster/Pickup/Particle Vertex Buffer (byte offset 5,600,000)
// 1850000..2049999: 3D Super-Shotgun Viewmodel Vertex Buffer (byte offset 7,400,000)

fn next_rand() -[Mem]-> i64 {
  let s = mem_load(26);
  let nxt = (s * 1103515245 + 12345) & 0x7FFFFFFF;
  let safe = if nxt == 0 { 9182736 } else { nxt };
  mem_store(26, safe);
  safe
}

fn fast_sin(ang: i64) -[Mem]-> i64 {
  mem_load(512 + (ang & 4095))
}

fn fast_cos(ang: i64) -[Mem]-> i64 {
  mem_load(512 + ((ang + 1024) & 4095))
}

fn init_trig_4096() -[Mem]-> unit {
  let mut i = 0;
  while i < 2048 max 2048 {
    let p = i * (2048 - i);
    // Bhaskara rational sine scaled to 2048 half-turn -> -1024..1024
    let p_shr = p >> 8;
    let denom = 81920 - ((4 * p) >> 8);
    let s = if denom > 0 { (16 * p_shr * 1024) / denom } else { 0 };
    mem_store(512 + i, s);
    mem_store(512 + 2048 + i, -s);
    i = i + 1;
  }
}

// --- Seamless Multi-Octave FBM & Worley Stone/Timber Texture Synthesis (256x256) ---

fn hash2d_wrap(ix: i64, iy: i64, mask: i64, seed: i64) -> i64 {
  let wx = ix & mask;
  let wy = iy & mask;
  let h1 = wx * 374761 + wy * 668265 + seed * 144269;
  let h2 = (h1 ^ (h1 >> 11)) * 12741261;
  (h2 >> 16) & 255
}

fn smooth_noise_256(x: i64, y: i64, shift: i64, seed: i64) -> i64 {
  let step = 1 << shift;
  let mask = (256 >> shift) - 1;
  let ix = x >> shift;
  let iy = y >> shift;
  let fx = ((x & (step - 1)) << 8) >> shift;
  let fy = ((y & (step - 1)) << 8) >> shift;
  let ux = (fx * fx * (768 - (fx << 1))) >> 16;
  let uy = (fy * fy * (768 - (fy << 1))) >> 16;

  let c00 = hash2d_wrap(ix, iy, mask, seed);
  let c10 = hash2d_wrap(ix + 1, iy, mask, seed);
  let c01 = hash2d_wrap(ix, iy + 1, mask, seed);
  let c11 = hash2d_wrap(ix + 1, iy + 1, mask, seed);

  let nx0 = c00 + (((c10 - c00) * ux) >> 8);
  let nx1 = c01 + (((c11 - c01) * ux) >> 8);
  nx0 + (((nx1 - nx0) * uy) >> 8)
}

fn fbm4_256(x: i64, y: i64, seed: i64) -> i64 {
  let n0 = smooth_noise_256(x, y, 5, seed);
  let n1 = smooth_noise_256(x, y, 4, seed + 17);
  let n2 = smooth_noise_256(x, y, 3, seed + 43);
  let n3 = smooth_noise_256(x, y, 2, seed + 89);
  (n0 * 116 + n1 * 72 + n2 * 44 + n3 * 24) >> 8
}

fn bake_hd_textures() -[Mem]-> unit {
  let mut y = 0;
  while y >= 0 && y < 256 max 256 {
    let mut x = 0;
    while x >= 0 && x < 256 max 256 {
      let fbm_a = fbm4_256(x, y, 11);
      let fbm_b = fbm4_256(x, y, 59);
      let fine = smooth_noise_256(x, y, 1, 103);

      // ----------------------------------------------------------------------
      // TEX 0: Wild Canyon Masonry & Sunlit Craggy Sandstone (Screenshot 2!)
      // Irregular staggered courses, chipped joints, moss & rich heightmap!
      // ----------------------------------------------------------------------
      let warp_y = y + ((fbm_a - 128) >> 4);
      let course = (warp_y >> 5) & 7; // 8 irregular courses per 256px
      let fy_in = warp_y & 31;
      let row_shift = hash2d_wrap(course, 3, 7, 21) >> 2;
      let warp_x = x + row_shift + ((fbm_b - 128) >> 4);
      let col_w = 48;
      let stone_id = (warp_x / col_w) & 7;
      let fx_in = warp_x - (warp_x / col_w) * col_w;

      let d_top = fy_in;
      let d_bot = 31 - fy_in;
      let d_left = fx_in;
      let d_right = col_w - 1 - fx_in;
      let min_v = if d_top < d_bot { d_top } else { d_bot };
      let min_h = if d_left < d_right { d_left } else { d_right };
      let edge_d = if min_v < min_h { min_v } else { min_h };

      let stone_tint = (hash2d_wrap(stone_id, course, 7, 77) & 31) - 14;
      let crag = (((fbm_a * 3 + fine) >> 2) - 128) * 3 / 2;
      let min_g = (fbm_b - 128) >> 3;
      let min_b = (fine - 128) >> 3;
      let is_mortar = edge_d <= 2;
      let bevel = if edge_d >= 8 { 256 } else { edge_d * 32 };
      let moss_patch = fbm_b > 160 && d_top < 10;

      let h0 = if is_mortar {
        8
      } else {
        clamp_byte(((168 + (crag * 2) / 3) * bevel) >> 8)
      };
      let r0 = if is_mortar {
        34 + (min_b >> 1)
      } else {
        if moss_patch { 76 + (fine >> 4) } else { 174 + stone_tint + (crag >> 2) }
      };
      let g0 = if is_mortar {
        29 + (min_g >> 1)
      } else {
        if moss_patch { 102 + min_g } else { 142 + (stone_tint * 3) / 4 + (crag >> 2) + min_g }
      };
      let b0 = if is_mortar {
        24
      } else {
        if moss_patch { 52 + (min_b >> 1) } else { 100 + stone_tint / 2 + (crag >> 3) + min_b }
      };
      mem_store(tex256_addr(0, x, y), pack_rgba_h(r0, g0, b0, h0));

      // ----------------------------------------------------------------------
      // TEX 1: Dark Gothic Castle Ashlar & Mossy Dungeon Stone (Screenshot 3!)
      // ----------------------------------------------------------------------
      let g_row = (y >> 4) & 15;
      let g_by = y & 15;
      let g_wx = (x + (g_row & 1) * 24 + ((fbm_a - 128) >> 5)) & 255;
      let g_bx = g_wx & 31;
      let g_ed_y = if g_by < 15 - g_by { g_by } else { 15 - g_by };
      let g_ed_x = if g_bx < 31 - g_bx { g_bx } else { 31 - g_bx };
      let g_ed = if g_ed_y < g_ed_x { g_ed_y } else { g_ed_x };
      let g_var = (hash2d_wrap(g_wx >> 5, g_row, 15, 33) & 31) - 15;
      let g_moss = fbm_b > 154 && (y > 172 || g_ed < 4);
      let h1 = if g_ed <= 1 { 10 } else { clamp_byte((if g_ed < 5 { 80 + g_ed * 26 } else { 186 }) + (crag >> 2)) };
      let r1 = if g_ed <= 1 { 22 } else { if g_moss { 54 + (min_b >> 1) } else { 108 + g_var + (crag >> 3) } };
      let g1 = if g_ed <= 1 { 20 } else { if g_moss { 82 + min_g } else { 90 + g_var + (crag >> 3) + min_g } };
      let b1 = if g_ed <= 1 { 18 } else { if g_moss { 42 + (min_b >> 1) } else { 66 + g_var / 2 + (crag >> 4) + min_b } };
      mem_store(tex256_addr(1, x, y), pack_rgba_h(r1, g1, b1, h1));

      // ----------------------------------------------------------------------
      // TEX 2: Weathered Mossy Timber Planks & Bolted Rafters (Screenshots 2 & 3!)
      // ----------------------------------------------------------------------
      let grain = fbm4_256((x * 3) & 255, (y >> 2) & 255, 131);
      let ring = smooth_noise_256((x * 6) & 255, (y >> 1) & 255, 2, 199);
      let plank_x = x & 63;
      let plank_gap = plank_x <= 2 || plank_x >= 62;
      let iron_band = y < 14 || y > 242;
      let bolt = iron_band && ((plank_x == 16 || plank_x == 48) && (y >= 4 && y <= 10 || y >= 245 && y <= 251));
      let wood_moss = fbm_b > 162 && !iron_band;
      let wood_v = ((grain * 2 + ring) / 3) - 128;
      let h2 = if plank_gap { 10 } else { if bolt { 252 } else { if iron_band { 210 } else { clamp_byte(155 + (wood_v >> 1)) } } };
      let r2 = if plank_gap { 20 } else { if bolt { 156 } else { if iron_band { 64 } else { if wood_moss { 74 } else { 132 + (wood_v >> 2) } } } };
      let g2 = if plank_gap { 17 } else { if bolt { 148 } else { if iron_band { 62 } else { if wood_moss { 98 } else { 96 + (wood_v >> 2) } } } };
      let b2 = if plank_gap { 14 } else { if bolt { 140 } else { if iron_band { 68 } else { if wood_moss { 50 } else { 58 + (wood_v >> 3) } } } };
      mem_store(tex256_addr(2, x, y), pack_rgba_h(r2, g2, b2, h2));

      // ----------------------------------------------------------------------
      // TEX 3: Fluted Limestone & Rusted-Collar Monumental Pillars (Screenshot 2!)
      // ----------------------------------------------------------------------
      let flute_phase = (x & 15) - 8;
      let flute_h = 84 - (flute_phase * flute_phase * 5) / 4; // Crisp vertical concave/convex fluting!
      let rust_band = (y >= 164 && y <= 255) || (y >= 60 && y <= 92);
      let rust_streak = fbm4_256((x * 2) & 255, (y >> 1) & 255, 211);
      let drum_seam = (y & 63) <= 2;
      let h3 = if drum_seam { 18 } else { clamp_byte(132 + flute_h + (crag >> 3)) };
      let r3 = if drum_seam { 42 } else { if rust_band && rust_streak > 100 { 164 + (crag >> 3) } else { 194 + (crag >> 3) } };
      let g3 = if drum_seam { 38 } else { if rust_band && rust_streak > 100 { 102 + (crag >> 3) } else { 186 + (crag >> 3) } };
      let b3 = if drum_seam { 36 } else { if rust_band && rust_streak > 100 { 62 } else { 174 + (crag >> 3) } };
      mem_store(tex256_addr(3, x, y), pack_rgba_h(r3, g3, b3, h3));

      // ----------------------------------------------------------------------
      // TEX 4: Terracotta Worn Dungeon Flagstones (Screenshot 3 Floor!)
      // ----------------------------------------------------------------------
      let fl_wx = (x + ((fbm_a - 128) >> 5)) & 255;
      let fl_wy = (y + ((fbm_b - 128) >> 5)) & 255;
      let fl_row = (fl_wy >> 5) & 7;
      let fl_tx = (fl_wx + (fl_row & 1) * 16) & 31;
      let fl_ty = fl_wy & 31;
      let fl_groove = fl_tx <= 1 || fl_ty <= 1;
      let fl_var = (hash2d_wrap((fl_wx + (fl_row & 1) * 16) >> 5, fl_row, 7, 91) & 23) - 11;
      let h4 = if fl_groove { 20 } else { clamp_byte(168 + (crag >> 2)) };
      let r4 = if fl_groove { 32 } else { 124 + fl_var + (crag >> 3) };
      let g4 = if fl_groove { 24 } else { 78 + (fl_var * 2) / 3 + (crag >> 3) };
      let b4 = if fl_groove { 20 } else { 54 + fl_var / 2 + (crag >> 4) };
      mem_store(tex256_addr(4, x, y), pack_rgba_h(r4, g4, b4, h4));

      // ----------------------------------------------------------------------
      // TEX 5: Boiling Radioactive Slime & Toxic Crust
      // ----------------------------------------------------------------------
      let sl_v = fbm4_256((x + (fbm_b >> 3)) & 255, (y + (fbm_a >> 3)) & 255, 251);
      let crust = sl_v < 96;
      let h5 = sl_v;
      let r5 = if crust { 38 } else { 64 + ((sl_v - 96) * 3) / 4 };
      let g5 = if crust { 68 } else { 155 + ((sl_v - 96) * 5) / 8 };
      let b5 = if crust { 28 } else { 36 + (sl_v >> 3) };
      mem_store(tex256_addr(5, x, y), pack_rgba_h(r5, g5, b5, h5));

      // ----------------------------------------------------------------------
      // TEX 6: Monster Atlas (Top half y<128: Pale Blood-Spattered Shambler Fur;
      //        Bottom half y>=128: Crimson Knight Enamel & Riveted Battle Steel)
      // ----------------------------------------------------------------------
      if y < 128 {
        let fur = fbm4_256((x * 2) & 255, (y * 4) & 255, 307);
        let blood = fbm_b > 176 && y > 48;
        let mr = if blood { 156 } else { 206 + ((fur - 128) >> 2) };
        let mg = if blood { 26 } else { 194 + ((fur - 128) >> 2) };
        let mb = if blood { 24 } else { 174 + ((fur - 128) >> 2) };
        mem_store(tex256_addr(6, x, y), pack_rgba_h(mr, mg, mb, 140 + (fur >> 2)));
      } else {
        let plate_seam = (x & 31) == 0 || (y & 31) == 0;
        let is_gold_trim = (y & 31) < 4;
        let ar = if plate_seam { 32 } else { if is_gold_trim { 208 } else { 168 + (crag >> 3) } };
        let ag = if plate_seam { 24 } else { if is_gold_trim { 164 } else { 34 + (crag >> 4) } };
        let ab = if plate_seam { 26 } else { if is_gold_trim { 56 } else { 36 + (crag >> 4) } };
        mem_store(tex256_addr(6, x, y), pack_rgba_h(ar, ag, ab, if plate_seam { 40 } else { 210 }));
      };

      // ----------------------------------------------------------------------
      // TEX 7: Pure Brushed Blued Gunmetal (`x < 128`) & Gleaming Brass (`x >= 128`)
      //        (`y >= 128` on gunmetal half has machined cooling slots; Elder Portal
      //        vortex is synthesized procedurally in GLSL!)
      // ----------------------------------------------------------------------
      let brushed = smooth_noise_256(x & 255, (y * 8) & 255, 2, 401);
      let brass = x >= 128;
      let vent = !brass && y >= 128 && ((x & 15) >= 5 && (x & 15) <= 10) && ((y & 31) >= 8 && (y & 31) <= 23);
      let rib = brass && ((y & 15) < 3);
      let gr = if vent { 14 } else { if brass { (if rib { 184 } else { 232 }) + ((brushed - 128) >> 3) } else { 76 + ((brushed - 128) >> 3) } };
      let gg = if vent { 15 } else { if brass { (if rib { 138 } else { 180 }) + ((brushed - 128) >> 3) } else { 84 + ((brushed - 128) >> 3) } };
      let gb = if vent { 18 } else { if brass { if rib { 48 } else { 68 } } else { 98 + ((brushed - 128) >> 3) } };
      let gh = if vent { 8 } else { if rib { 150 } else { 210 + (brushed >> 3) } };
      mem_store(tex256_addr(7, x, y), pack_rgba_h(gr, gg, gb, gh));

      x = x + 1;
    }
    y = y + 1;
  }
}

// --- 3D Polygonal Mesh Builder (`buf_kind`: 0=Static World, 1=Dynamic Entities, 2=3D Gun Viewmodel) ---

fn push_vertex(
  buf_kind: i64,
  x: i64,
  y: i64,
  z: i64,
  norm_packed: i64,
  u: i64,
  v: i64,
  tex_flags: i64,
  col_ao: i64
) -[Mem]-> unit {
  if buf_kind == 0 {
    let idx = mem_load(20);
    if idx < 98000 {
      let base = 600000 + idx * 8;
      mem_store(base, x);
      mem_store(base + 1, y);
      mem_store(base + 2, z);
      mem_store(base + 3, norm_packed);
      mem_store(base + 4, u);
      mem_store(base + 5, v);
      mem_store(base + 6, tex_flags);
      mem_store(base + 7, col_ao);
      mem_store(20, idx + 1);
    } else { () }
  } else {
    if buf_kind == 1 {
      let idx = mem_load(21);
      if idx < 55000 {
        let base = 1400000 + idx * 8;
        mem_store(base, x);
        mem_store(base + 1, y);
        mem_store(base + 2, z);
        mem_store(base + 3, norm_packed);
        mem_store(base + 4, u);
        mem_store(base + 5, v);
        mem_store(base + 6, tex_flags);
        mem_store(base + 7, col_ao);
        mem_store(21, idx + 1);
      } else { () }
    } else {
      let idx = mem_load(22);
      if idx < 22000 {
        let base = 1850000 + idx * 8;
        mem_store(base, x);
        mem_store(base + 1, y);
        mem_store(base + 2, z);
        mem_store(base + 3, norm_packed);
        mem_store(base + 4, u);
        mem_store(base + 5, v);
        mem_store(base + 6, tex_flags);
        mem_store(base + 7, col_ao);
        mem_store(22, idx + 1);
      } else { () }
    }
  }
}

fn pack_tint_ao(r: i64, g: i64, b: i64, ao: i64) -> i64 {
  clamp_byte(r) | (clamp_byte(g) << 8) | (clamp_byte(b) << 16) | (clamp_byte(ao) << 24)
}

// Emits an arbitrary 3D quad `(p0, p1, p2, p3)` with automatic cross-product 3D face normal!
fn emit_quad_3d(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64, u0: i64, v0: i64, ao0: i64,
  x1: i64, y1: i64, z1: i64, u1: i64, v1: i64, ao1: i64,
  x2: i64, y2: i64, z2: i64, u2: i64, v2: i64, ao2: i64,
  x3: i64, y3: i64, z3: i64, u3: i64, v3: i64, ao3: i64,
  tex_flags: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let ux = (x1 - x0) >> 3;
  let uy = (y1 - y0) >> 3;
  let uz = (z1 - z0) >> 3;
  let vx = (x3 - x0) >> 3;
  let vy = (y3 - y0) >> 3;
  let vz = (z3 - z0) >> 3;

  let cx = (uy * vz - uz * vy) >> 6;
  let cy = (uz * vx - ux * vz) >> 6;
  let cz = (ux * vy - uy * vx) >> 6;
  let len_sq = cx * cx + cy * cy + cz * cz;
  let len = isqrt_24bit(len_sq);
  let safe_len = if len <= 0 { 1 } else { len };
  let nx = (cx * 127) / safe_len;
  let ny = (cy * 127) / safe_len;
  let nz = (cz * 127) / safe_len;
  let n_pack = pack_norm(nx, ny, nz);

  let c0 = pack_tint_ao(tr, tg, tb, ao0);
  let c1 = pack_tint_ao(tr, tg, tb, ao1);
  let c2 = pack_tint_ao(tr, tg, tb, ao2);
  let c3 = pack_tint_ao(tr, tg, tb, ao3);

  // Tri 1: 0 -> 1 -> 2
  push_vertex(buf_kind, x0, y0, z0, n_pack, u0, v0, tex_flags, c0);
  push_vertex(buf_kind, x1, y1, z1, n_pack, u1, v1, tex_flags, c1);
  push_vertex(buf_kind, x2, y2, z2, n_pack, u2, v2, tex_flags, c2);
  // Tri 2: 0 -> 2 -> 3
  push_vertex(buf_kind, x0, y0, z0, n_pack, u0, v0, tex_flags, c0);
  push_vertex(buf_kind, x2, y2, z2, n_pack, u2, v2, tex_flags, c2);
  push_vertex(buf_kind, x3, y3, z3, n_pack, u3, v3, tex_flags, c3);
}

// Emits a full 6-sided 3D architectural brush / beam / step box (`x0..x1`, `y0..y1`, `z0..z1`)
fn emit_box_brush(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64,
  x1: i64, y1: i64, z1: i64,
  tex_id: i64,
  uv_scale: i64,
  tr: i64, tg: i64, tb: i64,
  ao_bot: i64, ao_top: i64
) -[Mem]-> unit {
  let sc = if uv_scale <= 0 { 2000 } else { uv_scale };
  let u_dx = ((x1 - x0) * 1024) / sc;
  let u_dz = ((z1 - z0) * 1024) / sc;
  let v_dy = ((y1 - y0) * 1024) / sc;

  // Front (+Z)
  emit_quad_3d(buf_kind,
    x0, y0, z1, 0, v_dy, ao_bot,
    x1, y0, z1, u_dx, v_dy, ao_bot,
    x1, y1, z1, u_dx, 0, ao_top,
    x0, y1, z1, 0, 0, ao_top,
    tex_id, tr, tg, tb);
  // Back (-Z)
  emit_quad_3d(buf_kind,
    x1, y0, z0, 0, v_dy, ao_bot,
    x0, y0, z0, u_dx, v_dy, ao_bot,
    x0, y1, z0, u_dx, 0, ao_top,
    x1, y1, z0, 0, 0, ao_top,
    tex_id, tr, tg, tb);
  // Left (-X)
  emit_quad_3d(buf_kind,
    x0, y0, z0, 0, v_dy, ao_bot,
    x0, y0, z1, u_dz, v_dy, ao_bot,
    x0, y1, z1, u_dz, 0, ao_top,
    x0, y1, z0, 0, 0, ao_top,
    tex_id, tr, tg, tb);
  // Right (+X)
  emit_quad_3d(buf_kind,
    x1, y0, z1, 0, v_dy, ao_bot,
    x1, y0, z0, u_dz, v_dy, ao_bot,
    x1, y1, z0, u_dz, 0, ao_top,
    x1, y1, z1, 0, 0, ao_top,
    tex_id, tr, tg, tb);
  // Top (+Y)
  emit_quad_3d(buf_kind,
    x0, y1, z1, 0, u_dz, ao_top,
    x1, y1, z1, u_dx, u_dz, ao_top,
    x1, y1, z0, u_dx, 0, ao_top,
    x0, y1, z0, 0, 0, ao_top,
    tex_id, tr, tg, tb);
  // Bottom (-Y)
  emit_quad_3d(buf_kind,
    x0, y0, z0, 0, u_dz, ao_bot,
    x1, y0, z0, u_dx, u_dz, ao_bot,
    x1, y0, z1, u_dx, 0, ao_bot,
    x0, y0, z1, 0, 0, ao_bot,
    tex_id, tr, tg, tb);
}

// Emits a tilted 3D wooden ceiling rafter / diagonal strut from `(ax, ay, az)` to `(bx, by, bz)`!
fn emit_tilted_beam(
  ax: i64, ay: i64, az: i64,
  bx: i64, by: i64, bz: i64,
  half_w: i64, half_h: i64,
  tex_id: i64
) -[Mem]-> unit {
  // Bottom, Top, and two Side quads along the 3D beam axis!
  emit_quad_3d(0,
    ax, ay - half_h, az - half_w, 0, 1024, 150,
    bx, by - half_h, bz - half_w, 3072, 1024, 150,
    bx, by - half_h, bz + half_w, 3072, 0, 150,
    ax, ay - half_h, az + half_w, 0, 0, 150,
    tex_id, 220, 200, 180);
  emit_quad_3d(0,
    ax, ay + half_h, az + half_w, 0, 1024, 210,
    bx, by + half_h, bz + half_w, 3072, 1024, 210,
    bx, by + half_h, bz - half_w, 3072, 0, 210,
    ax, ay + half_h, az - half_w, 0, 0, 210,
    tex_id, 240, 225, 205);
  // Front (+Z) & Back (-Z) beam faces
  emit_quad_3d(0,
    ax, ay - half_h, az + half_w, 0, 1024, 175,
    bx, by - half_h, bz + half_w, 3072, 1024, 175,
    bx, by + half_h, bz + half_w, 3072, 0, 215,
    ax, ay + half_h, az + half_w, 0, 0, 215,
    tex_id, 235, 215, 195);
  emit_quad_3d(0,
    bx, by - half_h, bz - half_w, 0, 1024, 175,
    ax, ay - half_h, az - half_w, 3072, 1024, 175,
    ax, ay + half_h, az - half_w, 3072, 0, 215,
    bx, by + half_h, bz - half_w, 0, 0, 215,
    tex_id, 235, 215, 195);
}

// Emits a smooth-shaded 3D quad with per-vertex custom normals (`tex_flags | 32`)!
fn emit_smooth_quad_3d(
  buf_kind: i64,
  x0: i64, y0: i64, z0: i64, n0: i64, u0: i64, v0: i64, ao0: i64,
  x1: i64, y1: i64, z1: i64, n1: i64, u1: i64, v1: i64, ao1: i64,
  x2: i64, y2: i64, z2: i64, n2: i64, u2: i64, v2: i64, ao2: i64,
  x3: i64, y3: i64, z3: i64, n3: i64, u3: i64, v3: i64, ao3: i64,
  tex_flags: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let c0 = pack_tint_ao(tr, tg, tb, ao0);
  let c1 = pack_tint_ao(tr, tg, tb, ao1);
  let c2 = pack_tint_ao(tr, tg, tb, ao2);
  let c3 = pack_tint_ao(tr, tg, tb, ao3);
  let tf = tex_flags | 32;

  push_vertex(buf_kind, x0, y0, z0, n0, u0, v0, tf, c0);
  push_vertex(buf_kind, x1, y1, z1, n1, u1, v1, tf, c1);
  push_vertex(buf_kind, x2, y2, z2, n2, u2, v2, tf, c2);

  push_vertex(buf_kind, x0, y0, z0, n0, u0, v0, tf, c0);
  push_vertex(buf_kind, x2, y2, z2, n2, u2, v2, tf, c2);
  push_vertex(buf_kind, x3, y3, z3, n3, u3, v3, tf, c3);
}

// Emits a Monumental 12-Sided Smooth-Shaded Fluted Stone & Rusted-Base Pillar (Screenshot 2 Right Column!)
fn emit_monumental_pillar(cx: i64, y0: i64, y1: i64, cz: i64, rad: i64) -[Mem]-> unit {
  let base_h = y0 + 1450;
  let base_rad = (rad * 5) / 4;
  let mut seg = 0;
  while seg < 12 max 12 {
    let a0 = (seg * 4096) / 12;
    let a1 = ((seg + 1) * 4096) / 12;
    let c0 = fast_cos(a0);
    let s0 = fast_sin(a0);
    let c1 = fast_cos(a1);
    let s1 = fast_sin(a1);

    let n0 = pack_norm((c0 * 124) >> 10, 12, (s0 * 124) >> 10);
    let n1 = pack_norm((c1 * 124) >> 10, 12, (s1 * 124) >> 10);
    let ns0 = pack_norm((c0 * 127) >> 10, 0, (s0 * 127) >> 10);
    let ns1 = pack_norm((c1 * 127) >> 10, 0, (s1 * 127) >> 10);

    // Flared rusted frustum base (`y0 .. base_h`)
    let bx0 = cx + ((base_rad * c0) >> 10);
    let bz0 = cz + ((base_rad * s0) >> 10);
    let bx1 = cx + ((base_rad * c1) >> 10);
    let bz1 = cz + ((base_rad * s1) >> 10);

    let sx0 = cx + ((rad * c0) >> 10);
    let sz0 = cz + ((rad * s0) >> 10);
    let sx1 = cx + ((rad * c1) >> 10);
    let sz1 = cz + ((rad * s1) >> 10);

    let u0 = (seg * 2048) / 12;
    let u1 = ((seg + 1) * 2048) / 12;

    emit_smooth_quad_3d(0,
      bx0, y0, bz0, n0, u0, 1024, 145,
      bx1, y0, bz1, n1, u1, 1024, 145,
      sx1, base_h, sz1, ns1, u1, 660, 228,
      sx0, base_h, sz0, ns0, u0, 660, 228,
      3, 245, 232, 215);

    // Tall fluted upper limestone column shaft (`base_h .. y1`)
    emit_smooth_quad_3d(0,
      sx0, base_h, sz0, ns0, u0, 2048, 228,
      sx1, base_h, sz1, ns1, u1, 2048, 228,
      sx1, y1, sz1, ns1, u1, 0, 205,
      sx0, y1, sz0, ns0, u0, 0, 205,
      3, 252, 246, 238);

    seg = seg + 1;
  }
  let base_col = (rad * 9) / 8;
  add_wall_collider(cx - base_col, cz - base_col, cx + base_col, cz + base_col, y0, base_h);
  add_wall_collider(cx - rad, cz - rad, cx + rad, cz + rad, base_h, y1);
}

// --- Physics Collider Registration (`walkable_sectors` & `wall_colliders`) ---

fn add_walk_sector(x0: i64, z0: i64, x1: i64, z1: i64, floor_y: i64, ceil_y: i64, hazard: i64) -[Mem]-> unit {
  let idx = mem_load(28);
  if idx < 48 {
    let base = 5000 + idx * 8;
    mem_store(base, x0);
    mem_store(base + 1, z0);
    mem_store(base + 2, x1);
    mem_store(base + 3, z1);
    mem_store(base + 4, floor_y);
    mem_store(base + 5, ceil_y);
    mem_store(base + 6, hazard);
    mem_store(28, idx + 1);
  } else { () }
}

fn add_wall_collider(x0: i64, z0: i64, x1: i64, z1: i64, y0: i64, y1: i64) -[Mem]-> unit {
  let idx = mem_load(29);
  if idx < 74 {
    let base = 5400 + idx * 8;
    mem_store(base, x0);
    mem_store(base + 1, z0);
    mem_store(base + 2, x1);
    mem_store(base + 3, z1);
    mem_store(base + 4, y0);
    mem_store(base + 5, y1);
    mem_store(29, idx + 1);
  } else { () }
}

fn emit_solid_wall(
  x0: i64, y0: i64, z0: i64,
  x1: i64, y1: i64, z1: i64,
  tex_id: i64, uv_sc: i64,
  ao_bot: i64, ao_top: i64
) -[Mem]-> unit {
  emit_box_brush(0, x0, y0, z0, x1, y1, z1, tex_id, uv_sc, 255, 255, 255, ao_bot, ao_top);
  add_wall_collider(x0, z0, x1, z1, y0, y1);
}

fn emit_wall_torch(x: i64, y: i64, z: i64) -[Mem]-> unit {
  // Iron bracket + burning brazier cup
  emit_box_brush(0, x - 90, y - 260, z - 90, x + 90, y, z + 90, 2, 800, 120, 105, 95, 160, 200);
  // Register static flickering point light
  let lc = mem_load(23);
  if lc < 20 {
    let lb = 8000 + lc * 8;
    mem_store(lb, x);
    mem_store(lb + 1, y + 180);
    mem_store(lb + 2, z);
    mem_store(lb + 3, 7800);
    mem_store(lb + 4, 255);
    mem_store(lb + 5, 168);
    mem_store(lb + 6, 68);
    mem_store(lb + 7, 1); // Flicker enabled!
    mem_store(23, lc + 1);
  } else { () }
}

// ============================================================================
// BUILD COMPLETE MULTI-LEVEL 3D ARCHITECTURE ("CANYON & CITADEL OF THE SLIPGATE")
// ============================================================================

fn build_citadel_3d_world() -[Mem]-> unit {
  mem_store(20, 0);
  mem_store(23, 0);
  mem_store(28, 0);
  mem_store(29, 0);

  // --------------------------------------------------------------------------
  // ZONE 1: SUNKEN CANYON & OVERHEAD SLATTED WOODEN BRIDGE (Screenshot 2!)
  // Bounds: X in [-5200 .. +5200], Z in [-18000 .. +4000], Floor Y = 0
  // --------------------------------------------------------------------------
  // Canyon Flagstone & Mossy Rock Floor
  emit_quad_3d(0,
    -5200, 0, 4000, 0, 7000, 195,
    5200, 0, 4000, 3500, 7000, 195,
    5200, 0, -18000, 3500, 0, 220,
    -5200, 0, -18000, 0, 0, 220,
    4, 240, 235, 220);
  add_walk_sector(-5000, -18000, 5000, 3800, 0, 9000, 0);

  // Left Mossy Stone Terrace Bench (`Y = 820` — jump straight up onto it with `Space`!)
  emit_solid_wall(-5200, 0, -9000, -3500, 820, 2500, 0, 2400, 155, 240);
  add_walk_sector(-5050, -9000, -3500, 2500, 820, 9000, 0);

  // Mid-Left Canyon Stepping Terrace (`Y = 1450` — connects Left Terrace up to North-West Terrace!)
  emit_solid_wall(-5200, 0, -13500, -3300, 1450, -9000, 0, 2400, 155, 242);
  add_walk_sector(-5050, -13500, -3300, -9000, 1450, 9000, 0);

  // South-West Carved Cliff Steps leading from Left Terrace up onto the Overhead Slatted Wooden Bridge (`Y = 3380`)!
  emit_solid_wall(-5200, 0, 1200, -3600, 1850, 3850, 0, 2200, 155, 245);
  add_walk_sector(-5050, 1200, -3600, 3850, 1850, 9000, 0);
  emit_solid_wall(-5200, 820, -1800, -3900, 2720, 1200, 0, 2200, 165, 248);
  add_walk_sector(-5050, -1800, -3900, 1200, 2720, 9000, 0);

  // Right-Side Canyon Stepping Ledge (`Y = 1100` — jump up to North-East Flanking Terrace!)
  emit_solid_wall(3600, 0, -13500, 5200, 1100, -9800, 0, 2400, 155, 240);
  add_walk_sector(3600, -13500, 5050, -9800, 1100, 9000, 0);

  // Towering Sunlit Wild-Stone Canyon Walls (`Tex 0`) — Open to the Crimson Storm Sky above!
  emit_solid_wall(-5800, 0, -18000, -5100, 7200, 4200, 0, 2800, 150, 255);
  emit_solid_wall(5100, 0, -18000, 5800, 7200, 4200, 0, 2800, 145, 245);
  // Back South Cliff behind player start (`Z = +3900 .. +4500`)
  emit_solid_wall(-5800, 0, 3900, 5800, 7200, 4500, 0, 2800, 145, 250);

  // 3 Monumental Fluted Stone & Rusted-Band Pillars on the Right (`X = +3600`, Screenshot 2!)
  emit_monumental_pillar(3600, 0, 7200, -1500, 780);
  emit_monumental_pillar(3600, 0, 7200, -6200, 780);
  emit_monumental_pillar(3600, 0, 7200, -11000, 780);

  // Warm Sunlight / Sky Glow Light Pool illuminating the Left Canyon Masonry!
  let s_lb = 8000 + mem_load(23) * 8;
  mem_store(s_lb, -2200);
  mem_store(s_lb + 1, 4600);
  mem_store(s_lb + 2, -4500);
  mem_store(s_lb + 3, 14000);
  mem_store(s_lb + 4, 255);
  mem_store(s_lb + 5, 218);
  mem_store(s_lb + 6, 162);
  mem_store(s_lb + 7, 0);
  mem_store(23, mem_load(23) + 1);

  // OVERHEAD SLATTED WOODEN PLANK BRIDGE (`Y = +3260`, spanning `X = -5100 .. +3100, Z = -5800 .. -1800`)!
  // Two heavy timber support stringer beams + 14 individual weathered mossy planks with crimson sky shining between them!
  emit_box_brush(0, -5100, 3080, -5650, 3100, 3260, -5430, 2, 2000, 195, 180, 160, 140, 215);
  emit_box_brush(0, -5100, 3080, -2170, 3100, 3260, -1950, 2, 2000, 195, 180, 160, 140, 215);
  let mut pl = 0;
  while pl < 14 max 14 {
    let px0 = -5050 + pl * 580;
    let px1 = px0 + 390; // 190mm open crimson-sky gap between every mossy wooden plank!
    emit_box_brush(0, px0, 3260, -5800, px1, 3380, -1800, 2, 1600, 238, 232, 210, 160, 248);
    pl = pl + 1;
  }
  // Walkable bridge deck at `Y = 3380`
  add_walk_sector(-5000, -5800, 3000, -1800, 3380, 9000, 0);

  // 6-Step Wide Stone Staircase at North end of Canyon (`Z = -13500 .. -18000`, `Y = 0 -> +1800`)!
  let mut st = 0;
  while st < 6 max 6 {
    let sz0 = -13500 - (st + 1) * 750;
    let sz1 = -13500 - st * 750;
    let sy_top = (st + 1) * 300;
    emit_box_brush(0, -2800, 0, sz0, 2800, sy_top, sz1, 4, 2000, 230, 220, 210, 150, 235);
    add_walk_sector(-2800, sz0, 2800, sz1, sy_top, 9000, 0);
    add_wall_collider(-2800, sz0, 2800, sz1, 0, sy_top);
    st = st + 1;
  }
  // Walkable Flanking Canyon Terraces beside staircase (`Y = 2200` — jumpable from stairs or side ledges!)
  emit_solid_wall(-5200, 0, -18000, -2800, 2200, -13500, 0, 2400, 150, 240);
  add_walk_sector(-5050, -18000, -2800, -13500, 2200, 9000, 0);
  emit_solid_wall(2800, 0, -18000, 5200, 2200, -13500, 0, 2400, 150, 240);
  add_walk_sector(2800, -18000, 5050, -13500, 2200, 9000, 0);

  // --------------------------------------------------------------------------
  // ZONE 2: GOTHIC VAULTED HALL WITH DIAGONAL TIMBER RAFTERS (Screenshot 3!)
  // Bounds: X in [-8400 .. +8400], Z in [-36000 .. -18000], Floor Y = +1800
  // --------------------------------------------------------------------------
  // Entrance Partition Walls at `Z = -18000` with grand central archway (`X = -2800 .. +2800`)
  emit_solid_wall(-8800, 0, -18400, -2800, 8200, -17600, 1, 2600, 135, 225);
  emit_solid_wall(2800, 0, -18400, 8800, 8200, -17600, 1, 2600, 135, 225);
  // Arch lintel above doorway (`Y = 5200 .. 8200`)
  emit_box_brush(0, -2800, 5200, -18400, 2800, 8200, -17600, 1, 2400, 210, 200, 195, 140, 210);
  add_wall_collider(-2800, -18400, 2800, -17600, 5200, 8200);

  // Terracotta Worn Flagstone Hall Floor (`Y = 1800`, `Tex 4`) + Glowing Slime Canal along East Side!
  emit_quad_3d(0,
    -8400, 1800, -18000, 0, 8000, 175,
    4600, 1800, -18000, 5800, 8000, 175,
    4600, 1800, -36000, 5800, 0, 175,
    -8400, 1800, -36000, 0, 0, 175,
    4, 245, 225, 210);
  add_walk_sector(-8200, -36000, 4600, -18000, 1800, 9200, 0);

  // Sunken Glowing Acid-Slime Trench on East flank (`X = 4600 .. 8400, Y = 1350`, `Tex 5` + flag 16 emissive!)
  emit_quad_3d(0,
    4600, 1350, -18000, 0, 6000, 255,
    8400, 1350, -18000, 2000, 6000, 255,
    8400, 1350, -36000, 2000, 0, 255,
    4600, 1350, -36000, 0, 0, 255,
    5 + 16, 255, 255, 255);
  add_walk_sector(4600, -36000, 8200, -18000, 1350, 9200, 1); // Hazard 1 = Acid Slime!
  // Iron Catwalk Bridge spanning the Acid Trench (`Z = -28500 .. -25500`)
  emit_box_brush(0, 4400, 1720, -28500, 8400, 1840, -25500, 2, 1800, 210, 205, 200, 150, 230);
  add_walk_sector(4400, -28500, 8200, -25500, 1840, 9200, 0);

  // Outer Castle Stone Walls of Gothic Hall (`Tex 1`)
  emit_solid_wall(-9000, 1800, -36500, -8300, 8400, -18000, 1, 2600, 130, 215);
  emit_solid_wall(8300, 1300, -36500, 9000, 8400, -18000, 1, 2600, 130, 215);

  // Left-Side Raised Wooden Gallery Balcony + Bolted Timber Support Posts (walkable via stepped supply crates!)
  emit_box_brush(0, -8300, 4400, -35500, -5200, 4650, -18400, 2, 2000, 220, 195, 170, 120, 215);
  add_walk_sector(-8200, -35500, -5500, -18400, 4650, 9000, 0);
  // Wooden parapet wall on gallery (`Y = 4650 .. 5700`, `Tex 2` — jumpable/protective cover!)
  emit_solid_wall(-5450, 4650, -35500, -5200, 5700, -20600, 2, 1600, 155, 225);
  // Stepped timber crates at South-West Hall corner (`Y = 2800` & `Y = 3780`) to jump up onto Left Gallery!
  emit_solid_wall(-8200, 1800, -19800, -6800, 2800, -18450, 2, 1400, 150, 230);
  add_walk_sector(-8200, -19800, -6800, -18450, 2800, 9000, 0);
  emit_solid_wall(-6800, 1800, -20400, -5500, 3780, -18450, 2, 1400, 150, 235);
  add_walk_sector(-6800, -20400, -5500, -18450, 3780, 9000, 0);
  // 4 Bolted Timber Support Columns under the left gallery
  emit_solid_wall(-5550, 1800, -21500, -5150, 4400, -21100, 2, 1200, 140, 210);
  emit_solid_wall(-5550, 1800, -26000, -5150, 4400, -25600, 2, 1200, 140, 210);
  emit_solid_wall(-5550, 1800, -30500, -5150, 4400, -30100, 2, 1200, 140, 210);
  emit_solid_wall(-5550, 1800, -34500, -5150, 4400, -34100, 2, 1200, 140, 210);

  // MASSIVE DIAGONAL WOODEN ROOF RAFTERS & CENTRAL RIDGE BEAM (exact Screenshot 3 ceiling!)
  // Central longitudinal ridge beam at `Y = 8600`
  emit_box_brush(0, -450, 8350, -36500, 450, 8950, -18000, 2, 2400, 205, 185, 165, 155, 210);
  let mut rf = 0;
  while rf < 4 max 4 {
    let rz = -20500 - rf * 4600;
    // Left & Right 35-degree tilted wooden rafters meeting at the ridge `(0, 8650, rz)`!
    emit_tilted_beam(-8300, 5800, rz, 0, 8650, rz, 280, 260, 2);
    emit_tilted_beam(8300, 5800, rz, 0, 8650, rz, 280, 260, 2);
    rf = rf + 1;
  }

  // Flickering Wall Torches + Glowing Green Slime Light in Gothic Hall!
  emit_wall_torch(-4950, 3400, -21300);
  emit_wall_torch(-4950, 3400, -30300);
  emit_wall_torch(8100, 3600, -23000);
  emit_wall_torch(8100, 3600, -32000);

  let sl_lb = 8000 + mem_load(23) * 8;
  mem_store(sl_lb, 6400);
  mem_store(sl_lb + 1, 2100);
  mem_store(sl_lb + 2, -27000);
  mem_store(sl_lb + 3, 9000);
  mem_store(sl_lb + 4, 90);
  mem_store(sl_lb + 5, 245);
  mem_store(sl_lb + 6, 75);
  mem_store(sl_lb + 7, 1);
  mem_store(23, mem_load(23) + 1);

  // --------------------------------------------------------------------------
  // ZONE 3: SANCTUM OF THE ELDER SLIPGATE (`Z = -49000 .. -36000`, Floor `Y = +2700`)
  // --------------------------------------------------------------------------
  // North Gothic Wall with Archway + 3-Step Altar Stairs (`Y = 1800 -> 2700`)
  emit_solid_wall(-9000, 1800, -36600, -2400, 8400, -35800, 1, 2600, 130, 215);
  emit_solid_wall(2400, 1800, -36600, 9000, 8400, -35800, 1, 2600, 130, 215);
  emit_box_brush(0, -2400, 5400, -36600, 2400, 8400, -35800, 1, 2400, 210, 200, 195, 140, 210);
  add_wall_collider(-2400, -36600, 2400, -35800, 5400, 8400);

  let mut ast = 0;
  while ast < 3 max 3 {
    let az0 = -36000 - (ast + 1) * 700;
    let az1 = -36000 - ast * 700;
    let ay_t = 1800 + (ast + 1) * 300;
    emit_box_brush(0, -2400, 1800, az0, 2400, ay_t, az1, 4, 1800, 235, 225, 215, 150, 235);
    add_walk_sector(-2400, az0, 2400, az1, ay_t, 9200, 0);
    add_wall_collider(-2400, az0, 2400, az1, 1800, ay_t);
    ast = ast + 1;
  }

  // Sanctum Arena (`X in -6200..+6200, Z in -49000..-38100, Y = 2700`)
  emit_quad_3d(0,
    -6200, 2700, -38100, 0, 5000, 180,
    6200, 2700, -38100, 5000, 5000, 180,
    6200, 2700, -49000, 5000, 0, 180,
    -6200, 2700, -49000, 0, 0, 180,
    4, 245, 230, 215);
  add_walk_sector(-6000, -48800, 6000, -38100, 2700, 9600, 0);

  emit_solid_wall(-6800, 2700, -49500, -6100, 8800, -36500, 1, 2600, 135, 220);
  emit_solid_wall(6100, 2700, -49500, 6800, 8800, -36500, 1, 2600, 135, 220);
  emit_solid_wall(-6800, 2700, -49600, 6800, 8800, -48900, 1, 2600, 135, 220);

  emit_monumental_pillar(-3400, 2700, 8600, -43500, 680);
  emit_monumental_pillar(3400, 2700, 8600, -43500, 680);
  emit_wall_torch(-5900, 4500, -43500);
  emit_wall_torch(5900, 4500, -43500);

  // GLOWING ELDER EXIT SLIPGATE ARCH (`X in -1800..+1800, Z = -48200, Y = 2700..6600`)!
  // Carved stone frame + swirling violet-gold portal surface (`Tex 7` lower half + emissive flag 16!)
  emit_solid_wall(-2200, 2700, -48600, -1500, 6800, -47800, 3, 1800, 170, 240);
  emit_solid_wall(1500, 2700, -48600, 2200, 6800, -47800, 3, 1800, 170, 240);
  emit_box_brush(0, -2300, 6500, -48700, 2300, 7300, -47700, 3, 1800, 240, 225, 200, 180, 250);

  emit_quad_3d(0,
    -1500, 2700, -48150, 0, 1024, 255,
    1500, 2700, -48150, 1024, 1024, 255,
    1500, 6500, -48150, 1024, 512, 255,
    -1500, 6500, -48150, 0, 512, 255,
    7 + 16, 255, 255, 255);

  // Violet-Gold Slipgate Point Light!
  let pg_lb = 8000 + mem_load(23) * 8;
  mem_store(pg_lb, 0);
  mem_store(pg_lb + 1, 4400);
  mem_store(pg_lb + 2, -47200);
  mem_store(pg_lb + 3, 10500);
  mem_store(pg_lb + 4, 215);
  mem_store(pg_lb + 5, 130);
  mem_store(pg_lb + 6, 255);
  mem_store(pg_lb + 7, 1);
  mem_store(23, mem_load(23) + 1);
}

// ============================================================================
// ARTICULATED 3D POLYGONAL MONSTERS & 3D TWIN-BARREL SUPER-SHOTGUN VIEWMODEL
// ============================================================================

// Emits a tapered smooth-shaded 3D organic/armored segment rotated around Y by `yaw`!
fn emit_tapered_limb(
  buf_kind: i64,
  cx: i64, cy: i64, cz: i64, yaw: i64,
  bx0: i64, bz0: i64, bx1: i64, bz1: i64,
  tx0: i64, tz0: i64, tx1: i64, tz1: i64,
  ly0: i64, ly1: i64,
  tex_flags: i64,
  u0: i64, v0: i64, u1: i64, v1: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let c = fast_cos(yaw);
  let s = fast_sin(yaw);

  // Bottom 4 rotated corners
  let x00b = cx + ((bx0 * c + bz0 * s) >> 10);
  let z00b = cz + ((-bx0 * s + bz0 * c) >> 10);
  let x10b = cx + ((bx1 * c + bz0 * s) >> 10);
  let z10b = cz + ((-bx1 * s + bz0 * c) >> 10);
  let x11b = cx + ((bx1 * c + bz1 * s) >> 10);
  let z11b = cz + ((-bx1 * s + bz1 * c) >> 10);
  let x01b = cx + ((bx0 * c + bz1 * s) >> 10);
  let z01b = cz + ((-bx0 * s + bz1 * c) >> 10);

  // Top 4 rotated corners
  let x00t = cx + ((tx0 * c + tz0 * s) >> 10);
  let z00t = cz + ((-tx0 * s + tz0 * c) >> 10);
  let x10t = cx + ((tx1 * c + tz0 * s) >> 10);
  let z10t = cz + ((-tx1 * s + tz0 * c) >> 10);
  let x11t = cx + ((tx1 * c + tz1 * s) >> 10);
  let z11t = cz + ((-tx1 * s + tz1 * c) >> 10);
  let x01t = cx + ((tx0 * c + tz1 * s) >> 10);
  let z01t = cz + ((-tx0 * s + tz1 * c) >> 10);

  // Smooth outward diagonal corner normals rotated by `yaw` for organic 3D Phong/bump shading!
  let n00 = pack_norm(((-88 * c - 88 * s) >> 10), 22, ((88 * s - 88 * c) >> 10));
  let n10 = pack_norm(((88 * c - 88 * s) >> 10), 22, ((-88 * s - 88 * c) >> 10));
  let n11 = pack_norm(((88 * c + 88 * s) >> 10), 22, ((-88 * s + 88 * c) >> 10));
  let n01 = pack_norm(((-88 * c + 88 * s) >> 10), 22, ((88 * s + 88 * c) >> 10));
  let nt00 = pack_norm(((-70 * c - 70 * s) >> 10), 72, ((70 * s - 70 * c) >> 10));
  let nt10 = pack_norm(((70 * c - 70 * s) >> 10), 72, ((-70 * s - 70 * c) >> 10));
  let nt11 = pack_norm(((70 * c + 70 * s) >> 10), 72, ((-70 * s + 70 * c) >> 10));
  let nt01 = pack_norm(((-70 * c + 70 * s) >> 10), 72, ((70 * s + 70 * c) >> 10));

  let y_b = cy + ly0;
  let y_t = cy + ly1;

  emit_smooth_quad_3d(buf_kind, x01b, y_b, z01b, n01, u0, v1, 180, x11b, y_b, z11b, n11, u1, v1, 180, x11t, y_t, z11t, nt11, u1, v0, 248, x01t, y_t, z01t, nt01, u0, v0, 248, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x10b, y_b, z10b, n10, u0, v1, 170, x00b, y_b, z00b, n00, u1, v1, 170, x00t, y_t, z00t, nt00, u1, v0, 238, x10t, y_t, z10t, nt10, u0, v0, 238, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x00b, y_b, z00b, n00, u0, v1, 175, x01b, y_b, z01b, n01, u1, v1, 175, x01t, y_t, z01t, nt01, u1, v0, 242, x00t, y_t, z00t, nt00, u0, v0, 242, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x11b, y_b, z11b, n11, u0, v1, 175, x10b, y_b, z10b, n10, u1, v1, 175, x10t, y_t, z10t, nt10, u1, v0, 242, x11t, y_t, z11t, nt11, u0, v0, 242, tex_flags, tr, tg, tb);
  emit_smooth_quad_3d(buf_kind, x01t, y_t, z01t, nt01, u0, v1, 252, x11t, y_t, z11t, nt11, u1, v1, 252, x10t, y_t, z10t, nt10, u1, v0, 252, x00t, y_t, z00t, nt00, u0, v0, 252, tex_flags, tr, tg, tb);
}

// Rotates local `(lx, ly, lz)` around Y by `yaw` (`0..4095`), translates to `(cx, cy, cz)`, and emits a smooth 3D limb!
fn emit_oriented_limb(
  buf_kind: i64,
  cx: i64, cy: i64, cz: i64, yaw: i64,
  lx0: i64, ly0: i64, lz0: i64,
  lx1: i64, ly1: i64, lz1: i64,
  tex_flags: i64,
  u0: i64, v0: i64, u1: i64, v1: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  emit_tapered_limb(
    buf_kind, cx, cy, cz, yaw,
    lx0, lz0, lx1, lz1,
    lx0, lz0, lx1, lz1,
    ly0, ly1,
    tex_flags, u0, v0, u1, v1, tr, tg, tb
  );
}

// Renders a True 3D Sculpted & Articulated Monster (`kind`: 1=Grunt, 2=Crimson Knight, 3=Pale Fanged Shambler Beast!)
fn emit_monster_3d(eid: i64) -[Mem]-> unit {
  if eid >= 0 && eid < 10 {
    let ea = enemy_addr(eid);
    let mx = mem_load(ea);
    let my = mem_load(ea + 1);
    let mz = mem_load(ea + 2);
    let kind = mem_load(ea + 3);
    let state = mem_load(ea + 5);
    let flash = mem_load(ea + 7);
    let anim = mem_load(ea + 8);
    let myaw = mem_load(ea + 9);

    let stride = (fast_sin(anim * 128) * 190) >> 10;
    let fl_boost = flash * 18;

    if state == 2 {
      // Fallen 3D Corpse on the dungeon stones!
      let cr = clamp_byte((if kind == 3 { 210 } else { 155 }) + fl_boost);
      let cg = if kind == 3 { 180 } else { 48 };
      let cb = if kind == 3 { 165 } else { 44 };
      emit_tapered_limb(1, mx, my, mz, myaw, -520, -680, 520, 680, -340, -480, 340, 480, 0, 310, 6, 0, 0, 512, 480, cr, cg, cb);
    } else {
      if kind == 3 {
        // ====================================================================
        // THE PALE FANGED SHAMBLER BEAST (Screenshot 3 Centerpiece — Sculpted!)
        // Tapered muscular haunches, massive V-tapered hunched shoulders,
        // gaping crimson maw with white fangs, & giant bloody 3-clawed arms!
        // ====================================================================
        let tr = clamp_byte(242 + fl_boost);
        let tg = clamp_byte(232 - flash * 12);
        let tb = clamp_byte(216 - flash * 12);

        // Tapered stomping furred legs + broad crimson-stained claws
        emit_tapered_limb(1, mx, my, mz, myaw, -460, -180 + stride, -170, 180 + stride, -560, -250 + stride / 2, -120, 250 + stride / 2, 180, 980, 6, 0, 0, 512, 480, tr, tg, tb);
        emit_tapered_limb(1, mx, my, mz, myaw, 170, -180 - stride, 460, 180 - stride, 120, -250 - stride / 2, 560, 250 - stride / 2, 180, 980, 6, 0, 0, 512, 480, tr, tg, tb);
        emit_tapered_limb(1, mx, my, mz, myaw, -560, -240 + stride, -110, 360 + stride, -460, -180 + stride, -170, 200 + stride, 0, 220, 6, 0, 540, 512, 980, 185, 34, 32);
        emit_tapered_limb(1, mx, my, mz, myaw, 110, -240 - stride, 560, 360 - stride, 170, -180 - stride, 460, 200 - stride, 0, 220, 6, 0, 540, 512, 980, 185, 34, 32);

        // V-Tapered waist (`-480..+480`) flaring into colossal hunched furred shoulders (`-840..+840`)!
        emit_tapered_limb(1, mx, my, mz, myaw, -480, -280, 480, 300, -780, -390, 780, 430, 920, 1820, 6, 0, 0, 1024, 480, tr, tg, tb);
        emit_tapered_limb(1, mx, my, mz, myaw, -780, -390, 780, 430, -560, -280, 560, 360, 1800, 2440, 6, 0, 0, 1024, 480, tr, tg, tb);

        // Gaping Crimson Maw recessed into the chest/head + Sharp Tapered White Fangs!
        emit_tapered_limb(1, mx, my, mz, myaw, -340, 340, 340, 520, -300, 320, 300, 500, 1660, 2240, 6, 0, 600, 512, 960, 162, 20, 22);
        emit_tapered_limb(1, mx, my, mz, myaw, -210, 490, -170, 540, -250, 470, -130, 560, 2020, 2230, 6, 0, 0, 128, 128, 255, 252, 240);
        emit_tapered_limb(1, mx, my, mz, myaw, -20, 490, 20, 540, -60, 470, 60, 560, 2000, 2230, 6, 0, 0, 128, 128, 255, 252, 240);
        emit_tapered_limb(1, mx, my, mz, myaw, 170, 490, 210, 540, 130, 470, 250, 560, 2020, 2230, 6, 0, 0, 128, 128, 255, 252, 240);
        emit_tapered_limb(1, mx, my, mz, myaw, -150, 470, -70, 550, -125, 490, -95, 535, 1670, 1870, 6, 0, 0, 128, 128, 255, 252, 240);
        emit_tapered_limb(1, mx, my, mz, myaw, 70, 470, 150, 550, 95, 490, 125, 535, 1670, 1870, 6, 0, 0, 128, 128, 255, 252, 240);

        // Huge Outstretched Muscular Biceps + Tapered Bloody 3-Clawed Forearms!
        let arm_sw = stride / 2;
        emit_tapered_limb(1, mx, my, mz, myaw, -1140, -60 - arm_sw, -760, 320 - arm_sw, -980, -160 - arm_sw, -680, 220 - arm_sw, 1420, 2220, 6, 0, 0, 512, 480, tr, tg, tb);
        emit_tapered_limb(1, mx, my, mz, myaw, 760, -60 + arm_sw, 1140, 320 + arm_sw, 680, -160 + arm_sw, 980, 220 + arm_sw, 1420, 2220, 6, 0, 0, 512, 480, tr, tg, tb);
        // Wicked crimson claws reaching forward!
        emit_tapered_limb(1, mx, my, mz, myaw, -1080, 420 - arm_sw, -840, 740 - arm_sw, -1160, 120 - arm_sw, -760, 420 - arm_sw, 1060, 1520, 6, 0, 600, 512, 980, 204, 26, 26);
        emit_tapered_limb(1, mx, my, mz, myaw, 840, 420 + arm_sw, 1080, 740 + arm_sw, 760, 120 + arm_sw, 1160, 420 + arm_sw, 1060, 1520, 6, 0, 600, 512, 980, 204, 26, 26);
      } else {
        if kind == 2 {
          // ==================================================================
          // CRIMSON CITADEL KNIGHT (Screenshot 3 Horned Red/Steel Warrior!)
          // ==================================================================
          let kr = clamp_byte(238 + fl_boost);
          // Tapered Armored Greaves
          emit_tapered_limb(1, mx, my, mz, myaw, -250, -110 + stride, -90, 110 + stride, -300, -140 + stride / 2, -65, 140 + stride / 2, 0, 840, 6, 0, 520, 512, 1000, 195, 175, 70);
          emit_tapered_limb(1, mx, my, mz, myaw, 90, -110 - stride, 250, 110 - stride, 65, -140 - stride / 2, 300, 140 - stride / 2, 0, 840, 6, 0, 520, 512, 1000, 195, 175, 70);
          // V-Tapered Crimson Enameled Chest Cuirass + Flared Steel Pauldrons
          emit_tapered_limb(1, mx, my, mz, myaw, -260, -160, 260, 180, -390, -220, 390, 240, 820, 1600, 6, 0, 560, 512, 980, kr, 56, 56);
          emit_tapered_limb(1, mx, my, mz, myaw, -580, -190, -340, 190, -440, -150, -310, 150, 1340, 1680, 7, 0, 0, 450, 450, 182, 188, 202);
          emit_tapered_limb(1, mx, my, mz, myaw, 340, -190, 580, 190, 310, -150, 440, 150, 1340, 1680, 7, 0, 0, 450, 450, 182, 188, 202);
          // Sculpted Great-Helm + Twin Curved Horns + Glowing Visor Slit + Forged Broadsword!
          emit_tapered_limb(1, mx, my, mz, myaw, -190, -175, 190, 195, -145, -145, 145, 160, 1580, 1980, 7, 0, 0, 450, 450, 172, 178, 192);
          emit_tapered_limb(1, mx, my, mz, myaw, -220, -40, -150, 40, -320, 40, -260, 110, 1840, 2140, 7, 560, 0, 960, 450, 225, 190, 95);
          emit_tapered_limb(1, mx, my, mz, myaw, 150, -40, 220, 40, 260, 40, 320, 110, 1840, 2140, 7, 560, 0, 960, 450, 225, 190, 95);
          emit_oriented_limb(1, mx, my, mz, myaw, -125, 1720, 185, 125, 1790, 212, 7 + 16, 600, 0, 900, 200, 255, 135, 35);
          // Swinging Right Sword Arm + Tapered Steel Broadsword
          emit_tapered_limb(1, mx, my, mz, myaw, 350, 140 + stride / 2, 500, 380 + stride / 2, 340, -80 + stride / 2, 520, 160 + stride / 2, 980, 1440, 6, 0, 560, 512, 980, kr, 64, 64);
          emit_tapered_limb(1, mx, my, mz, myaw, 405, 330 + stride / 2, 455, 490 + stride / 2, 422, 420 + stride / 2, 438, 540 + stride / 2, 1120, 2040, 7, 0, 0, 450, 450, 232, 238, 250);
        } else {
          // ==================================================================
          // TECH-BASE SHOTGUN GRUNT (Screenshot 3 Right Guard!)
          // ==================================================================
          let gr = clamp_byte(178 + fl_boost);
          emit_tapered_limb(1, mx, my, mz, myaw, -230, -105 + stride, -75, 105 + stride, -270, -130 + stride / 2, -55, 130 + stride / 2, 0, 790, 2, 0, 0, 512, 512, 138, 126, 88);
          emit_tapered_limb(1, mx, my, mz, myaw, 75, -105 - stride, 230, 105 - stride, 55, -130 - stride / 2, 270, 130 - stride / 2, 0, 790, 2, 0, 0, 512, 512, 138, 126, 88);
          emit_tapered_limb(1, mx, my, mz, myaw, -250, -155, 250, 175, -340, -195, 340, 215, 780, 1500, 3, 0, 0, 512, 512, gr, 160, 126);
          emit_tapered_limb(1, mx, my, mz, myaw, -175, -160, 175, 175, -140, -135, 140, 145, 1490, 1840, 7, 0, 0, 450, 450, 146, 152, 140);
          emit_oriented_limb(1, mx, my, mz, myaw, -130, 1615, 168, 130, 1685, 195, 7 + 16, 650, 0, 950, 200, 255, 195, 55);
          // Two sculpted arms + 3D Blaster Shotgun protruding forward!
          emit_tapered_limb(1, mx, my, mz, myaw, -410, 120, -290, 340, -450, -80, -310, 140, 1020, 1440, 3, 0, 0, 256, 256, gr, 148, 118);
          emit_tapered_limb(1, mx, my, mz, myaw, 290, 120, 410, 340, 310, -80, 450, 140, 1020, 1440, 3, 0, 0, 256, 256, gr, 148, 118);
          emit_tapered_limb(1, mx, my, mz, myaw, -75, 150, 105, 820, -55, 150, 85, 820, 1110, 1250, 7, 0, 0, 450, 450, 98, 106, 120);
        };
      };
    };
  } else { () }
}

// Emits an 8-Sided Smooth-Shaded Cylindrical Barrel/Tube along Viewmodel Z (`z0 .. z1`)!
fn emit_gun_cylinder_z(
  cx: i64, cy: i64, z0: i64, z1: i64,
  rx: i64, ry: i64,
  u0: i64, u1: i64, v0: i64, v1: i64,
  tr: i64, tg: i64, tb: i64
) -[Mem]-> unit {
  let mut seg = 0;
  while seg < 8 max 8 {
    let a0 = seg * 512;
    let a1 = (seg + 1) * 512;
    let c0 = fast_cos(a0);
    let s0 = fast_sin(a0);
    let c1 = fast_cos(a1);
    let s1 = fast_sin(a1);

    let x0 = cx + ((rx * c0) >> 10);
    let y0 = cy + ((ry * s0) >> 10);
    let x1 = cx + ((rx * c1) >> 10);
    let y1 = cy + ((ry * s1) >> 10);

    let n0 = pack_norm((c0 * 126) >> 10, (s0 * 126) >> 10, 12);
    let n1 = pack_norm((c1 * 126) >> 10, (s1 * 126) >> 10, 12);
    let su0 = u0 + ((u1 - u0) * seg) / 8;
    let su1 = u0 + ((u1 - u0) * (seg + 1)) / 8;
    let ao0 = 155 + ((s0 + 1024) * 48) / 1024;
    let ao1 = 155 + ((s1 + 1024) * 48) / 1024;

    emit_smooth_quad_3d(2,
      x0, y0, z1, n0, su0, v1, ao0,
      x1, y1, z1, n1, su1, v1, ao1,
      x1, y1, z0, n1, su1, v0, ao1,
      x0, y0, z0, n0, su0, v0, ao0,
      7, tr, tg, tb);
    seg = seg + 1;
  }
}

// Emits the Detailed 3D Cylindrical Twin-Barrel Super-Shotgun Viewmodel (Screenshot 2!)
fn emit_supershotgun_viewmodel_3d(recoil: i64, muzzle: i64, bob_x: i64, bob_y: i64) -[Mem]-> unit {
  mem_store(22, 0);
  // View-space coordinates (mm): X right, Y up, -Z into screen!
  let bx = bob_x;
  let by = -315 - bob_y - recoil * 6;
  let bz = recoil * 22;

  // 1. Heavy Dark Machined Receiver Housing across foreground (`u in 0..450` pure gunmetal!)
  emit_tapered_limb(2, bx, by, bz, 0,
    -178, -560, 178, -300,
    -148, -560, 148, -300,
    -98, 28, 7, 30, 60, 440, 460, 152, 158, 174);

  // 2. Twin Smooth-Shaded Cylindrical Blued-Steel Barrels with Machined Cooling Slots (`v: 480..980`!)
  emit_gun_cylinder_z(bx - 104, by - 4, bz - 1240, bz - 520, 48, 48, 40, 460, 480, 980, 196, 204, 222);
  emit_gun_cylinder_z(bx + 104, by - 4, bz - 1240, bz - 520, 48, 48, 40, 460, 480, 980, 196, 204, 222);

  // Dark Muzzle Bore Interiors at `Z = bz - 1242`
  emit_quad_3d(2, bx - 134, by - 34, bz - 1242, 40, 40, 40, bx - 74, by - 34, bz - 1242, 120, 40, 40, bx - 74, by + 26, bz - 1242, 120, 120, 40, bx - 134, by + 26, bz - 1242, 40, 120, 40, 7, 18, 20, 24);
  emit_quad_3d(2, bx + 74, by - 34, bz - 1242, 40, 40, 40, bx + 134, by - 34, bz - 1242, 120, 40, 40, bx + 134, by + 26, bz - 1242, 120, 120, 40, bx + 74, by + 26, bz - 1242, 40, 120, 40, 7, 18, 20, 24);

  // Slotted Upper Ventilated Rib Shrouds along both barrels (Screenshot 2 signature detail!)
  emit_tapered_limb(2, bx, by, bz, 0,
    -136, -1210, -72, -560,
    -124, -1210, -84, -560,
    42, 68, 7, 40, 520, 440, 980, 146, 152, 166);
  emit_tapered_limb(2, bx, by, bz, 0,
    72, -1210, 136, -560,
    84, -1210, 124, -560,
    42, 68, 7, 40, 520, 440, 980, 146, 152, 166);

  // 3. Twin Gleaming Cylindrical Brass Shells / Copper Feed Tubes nestled inside (`u in 580..980` pure brass!)
  emit_gun_cylinder_z(bx - 56, by + 22, bz - 1060, bz - 530, 22, 22, 580, 980, 40, 960, 255, 214, 102);
  emit_gun_cylinder_z(bx + 56, by + 22, bz - 1060, bz - 530, 22, 22, 580, 980, 40, 960, 255, 214, 102);
  // Central Ribbed Bronze Recoil Rod between barrels
  emit_gun_cylinder_z(bx, by - 12, bz - 1040, bz - 530, 24, 24, 580, 980, 40, 960, 220, 174, 86);

  // 4. 3D Volumetric Muzzle Blast Star at barrel tips when firing!
  if muzzle > 2 {
    let s = muzzle * 38;
    emit_quad_3d(2,
      bx - 160 - s, by - s, bz - 1260, 650, 128, 255,
      bx + 160 + s, by - s, bz - 1260, 950, 128, 255,
      bx + 160 + s, by + s, bz - 1260, 950, 0, 255,
      bx - 160 - s, by + s, bz - 1260, 650, 0, 255,
      7 + 16, 255, 215, 90);
  } else { () }
}

// ============================================================================
// SPAWNING, 3D COLLISION / STAIR PHYSICS, PARTICLES & COMBAT AI
// ============================================================================

fn spawn_monster_3d(eid: i64, x: i64, y: i64, z: i64, kind: i64, hp: i64, yaw: i64) -[Mem]-> unit {
  if eid >= 0 && eid < 10 {
    let ea = enemy_addr(eid);
    mem_store(ea, x);
    mem_store(ea + 1, y);
    mem_store(ea + 2, z);
    mem_store(ea + 3, kind);
    mem_store(ea + 4, hp);
    mem_store(ea + 5, 0);
    mem_store(ea + 6, 30 + eid * 5);
    mem_store(ea + 7, 0);
    mem_store(ea + 8, eid * 3);
    mem_store(ea + 9, yaw & 4095);
  } else { () }
}

fn spawn_pickup_3d(iid: i64, x: i64, y: i64, z: i64, kind: i64) -[Mem]-> unit {
  if iid >= 0 && iid < 10 {
    let ia = item_addr(iid);
    mem_store(ia, x);
    mem_store(ia + 1, y);
    mem_store(ia + 2, z);
    mem_store(ia + 3, kind);
    mem_store(ia + 4, 1);
  } else { () }
}

fn spawn_burst_particles(x: i64, y: i64, z: i64, is_blood: i64) -[Mem]-> unit {
  let mut k = 0;
  while k < 12 max 12 {
    // Find free or overwrite round-robin particle slot (`0..63`)
    let slot = (mem_load(0) * 7 + k * 5) & 63;
    let pb = 6800 + slot * 8;
    let r = next_rand();
    mem_store(pb, x);
    mem_store(pb + 1, y);
    mem_store(pb + 2, z);
    mem_store(pb + 3, ((r & 127) - 64) * 2);
    mem_store(pb + 4, 55 + ((r >> 7) & 63));
    mem_store(pb + 5, (((r >> 13) & 127) - 64) * 2);
    let col = if is_blood == 1 {
      pack_tint_ao(215, 24, 24, 255)
    } else {
      pack_tint_ao(255, 208, 86, 255)
    };
    mem_store(pb + 6, col);
    mem_store(pb + 7, 18 + (k & 7));
    k = k + 1;
  }
}

fn populate_entities() -[Mem]-> unit {
  // Canyon Guards (Zone 1 — facing +Z toward incoming player!)
  spawn_monster_3d(0, -1200, 0, -6800, 1, 40, 0);
  spawn_monster_3d(1, 1600, 0, -11200, 2, 75, 0);

  // Gothic Rafter Hall Ambush (Zone 2 — Grunts + Horned Crimson Knights + Pale Fanged Shambler!)
  spawn_monster_3d(2, -2300, 1800, -23200, 1, 45, 180);
  spawn_monster_3d(3, 1900, 1800, -23800, 2, 80, 3920);
  spawn_monster_3d(4, -350, 1800, -25800, 3, 165, 60); // Iconic Centerpiece Shambler facing player!
  spawn_monster_3d(5, 6400, 1840, -27000, 1, 45, 3200);
  spawn_monster_3d(6, -3200, 1800, -33500, 2, 85, 0);

  // Sanctum of the Elder Slipgate (Zone 3 — Twin Guards + Elder Shambler Boss!)
  spawn_monster_3d(7, -2800, 2700, -41500, 1, 50, 0);
  spawn_monster_3d(8, 2800, 2700, -41500, 2, 90, 0);
  spawn_monster_3d(9, 0, 2700, -45200, 3, 210, 0);

  // Pickups (1 = Medkit +30 HP, 2 = Shells +8, 3 = Crimson/Bronze Armor +50)
  spawn_pickup_3d(0, -2600, 0, -3200, 2);
  spawn_pickup_3d(1, 2100, 0, -9500, 1);
  spawn_pickup_3d(2, 0, 1800, -19500, 3);
  spawn_pickup_3d(3, -4200, 1800, -26500, 1);
  spawn_pickup_3d(4, 6800, 1840, -27000, 2);
  spawn_pickup_3d(5, 2200, 1800, -33000, 1);
  spawn_pickup_3d(6, -4200, 2700, -40000, 2);
  spawn_pickup_3d(7, 4200, 2700, -40000, 3);
  spawn_pickup_3d(8, 0, 2700, -39500, 1);
  spawn_pickup_3d(9, -1200, 3380, -3800, 3); // Bonus Armor up on the Wooden Bridge!

  let mut p = 0;
  while p < 64 max 64 {
    mem_store(6800 + p * 8 + 7, 0);
    p = p + 1;
  }
}

fn hits_wall_3d(px: i64, py: i64, pz: i64, rad: i64) -[Mem]-> bool {
  let cnt = mem_load(29);
  let mut hit = false;
  let mut i = 0;
  while i < cnt && !hit max 74 {
    let b = 5400 + i * 8;
    let x0 = mem_load(b) - rad;
    let z0 = mem_load(b + 1) - rad;
    let x1 = mem_load(b + 2) + rad;
    let z1 = mem_load(b + 3) + rad;
    let y0 = mem_load(b + 4);
    let y1 = mem_load(b + 5);
    // Allow auto-stepping stairs `<= 420mm` and jumping/mantling onto terraces once `py + 420 >= y1`!
    if px >= x0 && px <= x1 && pz >= z0 && pz <= z1 && py + 1500 > y0 && py + 420 < y1 {
      hit = true;
    } else { () };
    i = i + 1;
  }
  hit
}

// --- Exact 3D Slab Ray-Box Intersection for Pillar / Wall / Terrace Line-of-Sight! ---

fn slab_enter_1024(p0: i64, dp: i64, b0: i64, b1: i64) -> i64 {
  if dp > 0 {
    ((b0 - p0) * 1024) / dp
  } else {
    if dp < 0 {
      ((b1 - p0) * 1024) / dp
    } else {
      if p0 < b0 || p0 > b1 { 4096 } else { 0 }
    }
  }
}

fn slab_exit_1024(p0: i64, dp: i64, b0: i64, b1: i64) -> i64 {
  if dp > 0 {
    ((b1 - p0) * 1024) / dp
  } else {
    if dp < 0 {
      ((b0 - p0) * 1024) / dp
    } else {
      if p0 < b0 || p0 > b1 { -4096 } else { 1024 }
    }
  }
}

// Returns closest hit fraction `t in 0..1024` along 3D segment `(x0,y0,z0) -> (x1,y1,z1)`, or `2048` if clear!
fn ray_wall_hit_t_1024(x0: i64, y0: i64, z0: i64, x1: i64, y1: i64, z1: i64) -[Mem]-> i64 {
  let cnt = mem_load(29);
  let dx = x1 - x0;
  let dy = y1 - y0;
  let dz = z1 - z0;
  let mut best_t = 2048;
  let mut i = 0;
  while i < cnt max 74 {
    let b = 5400 + i * 8;
    // Slight +55mm X/Z pad ensures curved pillar silhouettes block grazing shots reliably!
    let bx0 = mem_load(b) - 55;
    let bz0 = mem_load(b + 1) - 55;
    let bx1 = mem_load(b + 2) + 55;
    let bz1 = mem_load(b + 3) + 55;
    let by0 = mem_load(b + 4);
    let by1 = mem_load(b + 5);

    let tx0 = slab_enter_1024(x0, dx, bx0, bx1);
    let tx1 = slab_exit_1024(x0, dx, bx0, bx1);
    let ty0 = slab_enter_1024(y0, dy, by0, by1);
    let ty1 = slab_exit_1024(y0, dy, by0, by1);
    let tz0 = slab_enter_1024(z0, dz, bz0, bz1);
    let tz1 = slab_exit_1024(z0, dz, bz0, bz1);

    let mxy0 = if tx0 > ty0 { tx0 } else { ty0 };
    let t_enter_raw = if mxy0 > tz0 { mxy0 } else { tz0 };
    let t_enter = if t_enter_raw > 16 { t_enter_raw } else { 16 };

    let mxy1 = if tx1 < ty1 { tx1 } else { ty1 };
    let t_exit_raw = if mxy1 < tz1 { mxy1 } else { tz1 };
    let t_exit = if t_exit_raw < 1008 { t_exit_raw } else { 1008 };

    if t_enter <= t_exit && t_enter < best_t {
      best_t = t_enter;
    } else { () };
    i = i + 1;
  }
  best_t
}

fn has_line_of_sight_3d(x0: i64, y0: i64, z0: i64, x1: i64, y1: i64, z1: i64) -[Mem]-> i64 {
  if ray_wall_hit_t_1024(x0, y0, z0, x1, y1, z1) <= 1008 { 0 } else { 1 }
}

fn find_floor_below(px: i64, py: i64, pz: i64) -[Mem]-> i64 {
  let cnt = mem_load(28);
  let mut best_y = -20000;
  let mut i = 0;
  while i < cnt max 50 {
    let b = 5000 + i * 8;
    if px >= mem_load(b) && px <= mem_load(b + 2) && pz >= mem_load(b + 1) && pz <= mem_load(b + 3) {
      let fy = mem_load(b + 4);
      // Allow stepping up stairs up to +420mm above current foot_y!
      if fy <= py + 420 && fy > best_y {
        best_y = fy;
      } else { () };
    } else { () };
    i = i + 1;
  }
  if best_y < -10000 { 0 } else { best_y }
}

fn save_snapshot_3d() -[Mem]-> unit {
  let head = mem_load(24);
  let slot = if head < 0 { 0 } else { if head >= 120 { 0 } else { head } };
  let base = snap_addr(slot);

  let mut h = 0;
  while h < 20 max 20 {
    mem_store(base + h, mem_load(h));
    h = h + 1;
  }
  mem_store(base + 26, mem_load(26));

  let mut e = 0;
  while e >= 0 && e < 10 max 10 {
    let ea = enemy_addr(e);
    let da = base + 32 + e * 12;
    let mut f = 0;
    while f < 10 max 10 {
      mem_store(da + f, mem_load(ea + f));
      f = f + 1;
    }
    e = e + 1;
  }

  let mut it = 0;
  while it >= 0 && it < 10 max 10 {
    let ia = item_addr(it);
    mem_store(base + 160 + it, mem_load(ia + 4));
    it = it + 1;
  }

  let nxt = if slot + 1 >= 120 { 0 } else { slot + 1 };
  mem_store(24, nxt);
  let cnt = mem_load(25);
  if cnt < 120 {
    mem_store(25, cnt + 1);
  } else { () }
}

export fn init_game(seed: i64) -[Mem, Gpu]-> i64 {
  let clean_seed = if seed <= 0 { 19960622 } else { seed & 0x7FFFFFFF };
  mem_store(0, 0);
  mem_store(1, -600);
  mem_store(2, 1680);
  mem_store(3, 1800);
  mem_store(4, 165);  // Slightly angled right toward the sunlit wall, pillars & overhead bridge!
  mem_store(5, 105);  // Slight upward gaze so the slatted wooden sky-bridge & pillars frame the view immediately!
  mem_store(6, 0);
  mem_store(7, 0);
  mem_store(8, 100);
  mem_store(9, 50);
  mem_store(10, 28);
  mem_store(11, 0);
  mem_store(12, 0);
  mem_store(13, 0);
  mem_store(14, 0);
  mem_store(15, 0);
  mem_store(16, 0);
  mem_store(17, 0);
  mem_store(18, 0);
  mem_store(19, 0);
  mem_store(21, 0);
  mem_store(22, 0);
  mem_store(24, 0);
  mem_store(25, 0);
  mem_store(26, clean_seed);
  mem_store(27, 1);

  init_trig_4096();
  bake_hd_textures();
  build_citadel_3d_world();
  populate_entities();
  build_dynamic_scene();
  save_snapshot_3d();

  do Gpu.submit(mem_load(20), mem_load(21));
  262144
}

fn damage_player(raw_dmg: i64) -[Mem]-> unit {
  let arm = mem_load(9);
  let absorb = if arm > 0 { (raw_dmg * 3) / 5 } else { 0 };
  let act = if absorb > arm { arm } else { absorb };
  let loss = raw_dmg - act;
  mem_store(9, arm - act);
  let nhp = clamp_stat(mem_load(8) - loss, 100);
  mem_store(8, nhp);
  mem_store(15, 10);
  mem_store(19, mem_load(19) | 16);
  if nhp <= 0 {
    mem_store(18, 2);
  } else { () }
}

fn fire_supershotgun_3d(cx: i64, cy: i64, cz: i64, yaw: i64, pitch: i64) -[Mem]-> unit {
  let ammo = mem_load(10);
  if ammo > 0 && mem_load(14) == 0 {
    mem_store(10, ammo - 1);
    mem_store(13, 7);  // Dynamic orange muzzle point-light!
    mem_store(14, 16); // Recoil + pump!
    mem_store(19, mem_load(19) | 1);

    let cp = fast_cos(pitch);
    let sp = fast_sin(pitch);
    let dx = (fast_sin(yaw) * cp) >> 10;
    let dy = sp;
    let dz = (-fast_cos(yaw) * cp) >> 10;

    // Clip player shotgun ray against solid walls, fluted pillars & terraces!
    let far_x = cx + ((dx * 32000) >> 10);
    let far_y = cy + ((dy * 32000) >> 10);
    let far_z = cz + ((dz * 32000) >> 10);
    let wall_frac = ray_wall_hit_t_1024(cx, cy, cz, far_x, far_y, far_z);
    let wall_dist = if wall_frac <= 1008 { (wall_frac * 32000) >> 10 } else { 32000 };

    let mut best_e = -1;
    let mut best_t = wall_dist;

    let mut e = 0;
    while e >= 0 && e < 10 max 10 {
      let ea = enemy_addr(e);
      if mem_load(ea + 5) != 2 {
        let ex = mem_load(ea);
        let ey = mem_load(ea + 1) + (if mem_load(ea + 3) == 3 { 1450 } else { 1050 });
        let ez = mem_load(ea + 2);
        let rx = ex - cx;
        let ry = ey - cy;
        let rz = ez - cz;

        let t_proj = (rx * dx + ry * dy + rz * dz) >> 10;
        if t_proj > 300 && t_proj < best_t {
          let hit_x = cx + ((dx * t_proj) >> 10);
          let hit_y = cy + ((dy * t_proj) >> 10);
          let hit_z = cz + ((dz * t_proj) >> 10);
          let spread = (if mem_load(ea + 3) == 3 { 980 } else { 640 }) + (t_proj >> 5);
          if abs_val(hit_x - ex) < spread && abs_val(hit_y - ey) < spread + 350 && abs_val(hit_z - ez) < spread {
            if has_line_of_sight_3d(cx, cy, cz, ex, ey, ez) == 1 {
              best_t = t_proj;
              best_e = e;
            } else { () };
          } else { () };
        } else { () };
      } else { () };
      e = e + 1;
    }

    if best_e >= 0 && best_e < 10 {
      let ta = enemy_addr(best_e);
      let raw_dmg = 68 - (best_t >> 9);
      let dmg = if raw_dmg < 26 { 26 } else { raw_dmg };
      let nhp = mem_load(ta + 4) - dmg;
      mem_store(ta + 7, 8);
      mem_store(ta + 5, 1);
      spawn_burst_particles(mem_load(ta), mem_load(ta + 1) + 1200, mem_load(ta + 2), 1);
      if nhp <= 0 {
        mem_store(ta + 4, 0);
        mem_store(ta + 5, 2);
        mem_store(11, mem_load(11) + 1);
        mem_store(19, mem_load(19) | 4);
      } else {
        mem_store(ta + 4, nhp);
        mem_store(19, mem_load(19) | 2);
      };
    } else {
      // Wall spark ricochet burst at exact 3D wall/pillar impact distance!
      let spark_d = if wall_dist < 18000 { wall_dist - 120 } else { 5200 };
      let sp_x = cx + ((dx * spark_d) >> 10);
      let sp_y = cy + ((dy * spark_d) >> 10);
      let sp_z = cz + ((dz * spark_d) >> 10);
      spawn_burst_particles(sp_x, sp_y, sp_z, 0);
    };
  } else { () }
}

fn build_dynamic_scene() -[Mem]-> unit {
  mem_store(21, 0);
  let tick = mem_load(0);

  // 1. Emit all 10 3D Articulated Monsters
  let mut e = 0;
  while e >= 0 && e < 10 max 10 {
    emit_monster_3d(e);
    e = e + 1;
  }

  // 2. Emit 3D Rotating Pickups (Medkits, Shell Crates, Crimson/Bronze Armor)
  let spin = (tick * 24) & 4095;
  let mut it = 0;
  while it >= 0 && it < 10 max 10 {
    let ia = item_addr(it);
    if mem_load(ia + 4) == 1 {
      let ix = mem_load(ia);
      let iy = mem_load(ia + 1) + 180 + ((fast_sin(tick * 64 + it * 400) * 90) >> 10);
      let iz = mem_load(ia + 2);
      let ik = mem_load(ia + 3);
      if ik == 1 {
        // White 3D Medkit with Crimson Cross
        emit_oriented_limb(1, ix, iy, iz, spin, -240, 0, -240, 240, 320, 240, 3, 0, 0, 256, 256, 235, 238, 242);
        emit_oriented_limb(1, ix, iy + 320, iz, spin, -70, 0, -210, 70, 50, 210, 6 + 16, 0, 600, 256, 900, 235, 38, 38);
        emit_oriented_limb(1, ix, iy + 320, iz, spin, -210, 0, -70, 210, 50, 70, 6 + 16, 0, 600, 256, 900, 235, 38, 38);
      } else {
        if ik == 2 {
          // Brass-Bound Buckshot Shell Crate
          emit_oriented_limb(1, ix, iy, iz, spin, -240, 0, -180, 240, 300, 180, 7, 520, 0, 1000, 480, 235, 192, 85);
        } else {
          // Floating Crimson/Gold Battle Cuirass Armor
          emit_oriented_limb(1, ix, iy, iz, spin, -280, 0, -180, 280, 480, 180, 6, 0, 560, 512, 980, 235, 95, 55);
        };
      };
    } else { () };
    it = it + 1;
  }

  // 3. Emit Glowing 3D Torch Flames on all flickering torch lights!
  let lcnt = mem_load(23);
  let mut li = 0;
  while li < lcnt max 22 {
    let lb = 8000 + li * 8;
    if mem_load(lb + 7) == 1 && mem_load(lb + 4) == 255 && mem_load(lb + 5) == 168 {
      let fx = mem_load(lb);
      let fy = mem_load(lb + 1) - 120;
      let fz = mem_load(lb + 2);
      let fl_h = 320 + (((tick * 13 + li * 7) & 7) * 22);
      emit_oriented_limb(1, fx, fy, fz, (tick * 48) & 4095, -85, 0, -85, 85, fl_h, 85, 7 + 16, 650, 0, 950, 200, 255, 195, 65);
    } else { () };
    li = li + 1;
  }

  // 4. Step & Emit 3D Blood / Ricochet Spark Shards
  let mut p = 0;
  while p < 64 max 64 {
    let pb = 6800 + p * 8;
    let life = mem_load(pb + 7);
    if life > 0 {
      let npx = mem_load(pb) + mem_load(pb + 3);
      let npy = mem_load(pb + 1) + mem_load(pb + 4);
      let npz = mem_load(pb + 2) + mem_load(pb + 5);
      mem_store(pb, npx);
      mem_store(pb + 1, npy);
      mem_store(pb + 2, npz);
      mem_store(pb + 4, mem_load(pb + 4) - 9); // Gravity!
      mem_store(pb + 7, life - 1);
      let col = mem_load(pb + 6);
      emit_box_brush(1, npx - 36, npy - 36, npz - 36, npx + 36, npy + 36, npz + 36, 6 + 16, 400, col & 255, (col >> 8) & 255, (col >> 16) & 255, 255, 255);
    } else { () };
    p = p + 1;
  }

  // 5. Emit 3D Twin-Barrel Super-Shotgun Viewmodel
  let bob_t = mem_load(17);
  let bob_x = (fast_cos(bob_t >> 1) * 18) >> 10;
  let bob_y = abs_val((fast_sin(bob_t) * 16) >> 10);
  emit_supershotgun_viewmodel_3d(mem_load(14), mem_load(13), bob_x, bob_y);
}

export fn step_fps(
  move_fwd: i64,
  move_strafe: i64,
  yaw_delta: i64,
  pitch_delta: i64,
  jump_in: i64,
  fire_in: i64
) -[Mem, Gpu]-> i64 {
  let state = mem_load(18);
  if state != 0 {
    build_dynamic_scene();
    do Gpu.submit(mem_load(20), mem_load(21));
    262144
  } else {
    let tick = mem_load(0) + 1;
    mem_store(0, tick);

    if mem_load(13) > 0 { mem_store(13, mem_load(13) - 1); } else { () };
    if mem_load(14) > 0 { mem_store(14, mem_load(14) - 1); } else { () };
    if mem_load(15) > 0 { mem_store(15, mem_load(15) - 1); } else { () };
    if mem_load(16) > 0 { mem_store(16, mem_load(16) - 1); } else { () };

    let yaw = (mem_load(4) + yaw_delta) & 4095;
    let pitch = clamp_pitch(mem_load(5) + pitch_delta);
    mem_store(4, yaw);
    mem_store(5, pitch);

    let fwd_x = fast_sin(yaw);
    let fwd_z = -fast_cos(yaw);
    let right_x = fast_cos(yaw);
    let right_z = fast_sin(yaw);

    let spd = 148;
    let vx = ((move_fwd * fwd_x + move_strafe * right_x) * spd) >> 10;
    let vz = ((move_fwd * fwd_z + move_strafe * right_z) * spd) >> 10;

    let mut px = mem_load(1);
    let mut foot_y = mem_load(6);
    let mut pz = mem_load(3);

    // Apply Spacebar Jump (`vy = 165`, peak ~1.36m) BEFORE horizontal step so jumping up onto side terraces is effortless!
    let mut vy = mem_load(7);
    if jump_in > 0 && mem_load(27) == 1 {
      vy = 165;
      mem_store(27, 0);
      mem_store(19, mem_load(19) | 64);
    } else { () };

    let next_y_air = foot_y + vy;

    if !hits_wall_3d(px + vx, next_y_air, pz, 380) {
      px = px + vx;
    } else { () };
    if !hits_wall_3d(px, next_y_air, pz + vz, 380) {
      pz = pz + vz;
    } else { () };

    // 3D Floor / Stair / Side-Terrace Elevation + Gravity!
    let target_floor = find_floor_below(px, next_y_air, pz);
    foot_y = next_y_air;
    if foot_y <= target_floor {
      foot_y = target_floor;
      vy = 0;
      mem_store(27, 1);
    } else {
      vy = vy - 10;
      mem_store(27, 0);
    };

    let mut bob_y = 0;
    if (move_fwd != 0 || move_strafe != 0) && mem_load(27) == 1 {
      let nbob = (mem_load(17) + 190) & 4095;
      mem_store(17, nbob);
      bob_y = (fast_sin(nbob) * 45) >> 10;
      if (nbob & 1023) < 190 {
        mem_store(19, mem_load(19) | 64);
      } else { () };
    } else { () };

    let eye_y = foot_y + 1680 + bob_y;
    mem_store(1, px);
    mem_store(2, eye_y);
    mem_store(3, pz);
    mem_store(6, foot_y);
    mem_store(7, vy);

    // Check Elder Exit Slipgate Arch (`X in -1600..1600, Z <= -47300`)!
    if abs_val(px) < 1600 && pz <= -47300 {
      mem_store(18, 1);
      mem_store(19, mem_load(19) | 128);
    } else { () };

    // Check Acid Slime Trench Hazard (`X > 4600, foot_y <= 1400`)
    if px > 4600 && foot_y <= 1400 && (tick & 31) == 0 {
      damage_player(6);
    } else { () };

    // Check 3D Pickups
    let mut it = 0;
    while it >= 0 && it < 10 max 10 {
      let ia = item_addr(it);
      if mem_load(ia + 4) == 1 {
        if abs_val(mem_load(ia) - px) < 820 && abs_val(mem_load(ia + 1) - foot_y) < 1100 && abs_val(mem_load(ia + 2) - pz) < 820 {
          let ik = mem_load(ia + 3);
          if ik == 1 && mem_load(8) < 100 {
            mem_store(8, clamp_stat(mem_load(8) + 30, 100));
            mem_store(ia + 4, 0);
            mem_store(16, 8);
            mem_store(19, mem_load(19) | 32);
          } else {
            if ik == 2 {
              mem_store(10, clamp_stat(mem_load(10) + 8, 99));
              mem_store(ia + 4, 0);
              mem_store(16, 8);
              mem_store(19, mem_load(19) | 32);
            } else {
              if ik == 3 && mem_load(9) < 100 {
                mem_store(9, clamp_stat(mem_load(9) + 50, 100));
                mem_store(ia + 4, 0);
                mem_store(16, 8);
                mem_store(19, mem_load(19) | 32);
              } else { () };
            };
          };
        } else { () };
      } else { () };
      it = it + 1;
    }

    if fire_in > 0 {
      fire_supershotgun_3d(px, eye_y, pz, yaw, pitch);
    } else { () };

    // Step 3D Monster AI (Aggro, Turn Toward Player, Stalk & Attack!)
    let mut e = 0;
    while e >= 0 && e < 10 max 10 {
      let ea = enemy_addr(e);
      if mem_load(ea + 7) > 0 {
        mem_store(ea + 7, mem_load(ea + 7) - 1);
      } else { () };

      let est = mem_load(ea + 5);
      if est != 2 {
        let ex = mem_load(ea);
        let ey = mem_load(ea + 1);
        let ez = mem_load(ea + 2);
        let dx = px - ex;
        let dz = pz - ez;
        let dist = abs_val(dx) + abs_val(dz);

        let has_los = has_line_of_sight_3d(ex, ey + 1150, ez, px, eye_y - 200, pz) == 1;

        // Monsters only wake up when they actually SEE the player (or hear gunfire very close)!
        if est == 0 && dist < 16500 && abs_val(foot_y - ey) < 2800 && (has_los || (fire_in > 0 && dist < 7200)) {
          mem_store(ea + 5, 1);
        } else { () };

        if mem_load(ea + 5) == 1 {
          mem_store(ea + 8, (mem_load(ea + 8) + 1) & 1023);
          // Orient monster local +Z (`(sin(yaw), cos(yaw))`) directly toward player!
          let approx_yaw = if abs_val(dx) > abs_val(dz) {
            if dx > 0 { 1024 - (dz * 420) / (abs_val(dx) + 1) } else { 3072 + (dz * 420) / (abs_val(dx) + 1) }
          } else {
            if dz > 0 { (dx * 420) / (abs_val(dz) + 1) } else { 2048 - (dx * 420) / (abs_val(dz) + 1) }
          };
          mem_store(ea + 9, approx_yaw & 4095);

          let ek = mem_load(ea + 3);
          let mspd = if ek == 2 { 68 } else { if ek == 3 { 54 } else { 44 } };
          if dist > 1650 && dist > 0 {
            let sx = (dx * mspd) / dist;
            let sz = (dz * mspd) / dist;
            if !hits_wall_3d(ex + sx, ey, ez + sz, 450) {
              let nfy = find_floor_below(ex + sx, ey, ez + sz);
              if abs_val(nfy - ey) <= 420 {
                mem_store(ea, ex + sx);
                mem_store(ea + 1, nfy);
                mem_store(ea + 2, ez + sz);
              } else { () };
            } else { () };
          } else { () };

          let cd = mem_load(ea + 6) - 1;
          if cd <= 0 {
            // Sword-wielding Crimson Knights (`ek == 2`) must close to melee/lunge range (`< 2800mm`),
            // AND EVERY monster attack STRICTLY requires unobstructed 3D Line-of-Sight (`has_los`)!
            // Hiding behind a fluted pillar, wall, archway, or terrace completely blocks enemy fire!
            let max_atk_dist = if ek == 2 { 2800 } else { if ek == 3 { 11500 } else { 13000 } };
            if has_los && dist < max_atk_dist && abs_val(foot_y - ey) < 2600 {
              mem_store(19, mem_load(19) | 8);
              if ek != 2 {
                spawn_burst_particles(ex, ey + 1250, ez, 0);
              } else { () };
              if (next_rand() & 3) != 0 {
                let mdmg = if ek == 3 { 16 } else { if ek == 2 { 14 } else { 7 } };
                damage_player(mdmg);
              } else { () };
            } else { () };
            mem_store(ea + 6, if ek == 3 { 44 } else { if ek == 2 { 38 } else { 56 } });
          } else {
            mem_store(ea + 6, cd);
          };
        } else { () };
      } else { () };
      e = e + 1;
    }

    let safe_kills = clamp_stat(mem_load(11), 10);
    let safe_hp = clamp_stat(mem_load(8), 100);
    let win_b = if mem_load(18) == 1 { 1500 } else { 0 };
    mem_store(12, compute_fps_score(safe_kills, safe_hp, win_b));

    if (tick & 3) == 0 {
      save_snapshot_3d();
    } else { () };

    build_dynamic_scene();
    do Gpu.submit(mem_load(20), mem_load(21));
    262144
  }
}

export fn rewind_combat(steps_back: i64) -[Mem, Gpu]-> i64 {
  let cnt = mem_load(25);
  if cnt <= 0 {
    build_dynamic_scene();
    do Gpu.submit(mem_load(20), mem_load(21));
    262144
  } else {
    let clamped = if steps_back < 0 { 0 } else { if steps_back >= cnt { cnt - 1 } else { steps_back } };
    let raw = mem_load(24) - 1 - clamped;
    let wrapped = if raw < 0 { raw + 120 } else { raw };
    let slot = if wrapped < 0 { 0 } else { if wrapped >= 120 { 0 } else { wrapped } };
    let base = snap_addr(slot);

    let mut h = 0;
    while h < 20 max 20 {
      mem_store(h, mem_load(base + h));
      h = h + 1;
    }
    mem_store(26, mem_load(base + 26));

    let mut e = 0;
    while e >= 0 && e < 10 max 10 {
      let ea = enemy_addr(e);
      let da = base + 32 + e * 12;
      let mut f = 0;
      while f < 10 max 10 {
        mem_store(ea + f, mem_load(da + f));
        f = f + 1;
      }
      e = e + 1;
    }

    let mut it = 0;
    while it >= 0 && it < 10 max 10 {
      let ia = item_addr(it);
      mem_store(ia + 4, mem_load(base + 160 + it));
      it = it + 1;
    }

    build_dynamic_scene();
    do Gpu.submit(mem_load(20), mem_load(21));
    262144
  }
}

// --- Exported GPU Buffer Offsets & Telemetry Getters ---

export fn get_tex_byte_offset() -> i64
  ens result == 262144
{
  262144
}

export fn get_static_vbo_byte_offset() -> i64
  ens result == 2400000
{
  2400000
}

export fn get_dyn_vbo_byte_offset() -> i64
  ens result == 5600000
{
  5600000
}

export fn get_gun_vbo_byte_offset() -> i64
  ens result == 7400000
{
  7400000
}

export fn get_lights_byte_offset() -> i64
  ens result == 32000
{
  32000
}

export fn get_static_vert_count() -[Mem]-> i64 { mem_load(20) }
export fn get_dyn_vert_count() -[Mem]-> i64 { mem_load(21) }
export fn get_gun_vert_count() -[Mem]-> i64 { mem_load(22) }
export fn get_light_count() -[Mem]-> i64 { mem_load(23) }

export fn pop_sfx() -[Mem]-> i64 {
  let m = mem_load(19);
  mem_store(19, 0);
  m
}

export fn get_cam_x() -[Mem]-> i64 { mem_load(1) }
export fn get_cam_y() -[Mem]-> i64 { mem_load(2) }
export fn get_cam_z() -[Mem]-> i64 { mem_load(3) }
export fn get_cam_yaw() -[Mem]-> i64 { mem_load(4) }
export fn get_cam_pitch() -[Mem]-> i64 { mem_load(5) }
export fn get_muzzle() -[Mem]-> i64 { mem_load(13) }
export fn get_hurt() -[Mem]-> i64 { mem_load(15) }
export fn get_pickup() -[Mem]-> i64 { mem_load(16) }

export fn get_health() -[Mem]-> i64 { mem_load(8) }
export fn get_armor() -[Mem]-> i64 { mem_load(9) }
export fn get_ammo() -[Mem]-> i64 { mem_load(10) }
export fn get_kills() -[Mem]-> i64 { mem_load(11) }
export fn get_score() -[Mem]-> i64 { mem_load(12) }
export fn get_state() -[Mem]-> i64 { mem_load(18) }
export fn get_tick() -[Mem]-> i64 { mem_load(0) }
export fn get_snap_count() -[Mem]-> i64 { mem_load(25) }

export fn set_camera_pose(x: i64, y: i64, z: i64, yaw: i64, pitch: i64) -[Mem, Gpu]-> unit {
  mem_store(1, x);
  mem_store(2, y);
  mem_store(3, z);
  mem_store(4, yaw & 4095);
  mem_store(5, clamp_pitch(pitch));
  mem_store(6, y - 1680);
  mem_store(7, 0);
  mem_store(27, 1);
  build_dynamic_scene();
  do Gpu.submit(mem_load(20), mem_load(21));
}

export fn check_los_3d(x0: i64, y0: i64, z0: i64, x1: i64, y1: i64, z1: i64) -[Mem]-> i64 {
  has_line_of_sight_3d(x0, y0, z0, x1, y1, z1)
}
